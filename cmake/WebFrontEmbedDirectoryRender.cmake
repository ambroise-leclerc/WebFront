# Renders the provider of webfront_embed_directory() (cmake/WebFrontEmbedDirectory.cmake): one header-only class whose
# static open() serves every file listed in MANIFEST, read from DIRECTORY, identity encoded, in pure CMake. The bytes take
# the layout of the core's embedded assets (js/core/EmbedAsset.cmake): big-endian 64-bit words, the last one padded with
# zeros, dataSize excluding the padding.
#   cmake -DDIRECTORY=<dir> -DMANIFEST=<file> -DCLASS=<name> -DNAMESPACE=<ns> -DOUTPUT=<header> -P WebFrontEmbedDirectoryRender.cmake
# MANIFEST holds one relative path per line, sorted, already validated by webfront_embed_directory().
cmake_minimum_required(VERSION 3.31)

foreach(variable DIRECTORY MANIFEST CLASS NAMESPACE OUTPUT)
    if(NOT DEFINED ${variable})
        message(FATAL_ERROR "${variable} is required")
    endif()
endforeach()

file(STRINGS "${MANIFEST}" paths ENCODING UTF-8)

# The words of one file, five per line. A single regular expression pass over the whole hexadecimal text renders the
# words, and a second one breaks the lines, so the time stays linear in the size of the file.
function(_webfront_render_words path out_size out_count out_body)
    file(SIZE "${path}" size)
    file(READ "${path}" hex HEX)
    math(EXPR count "(${size} + 7) / 8")
    set(body "")
    if(size GREATER 0)
        string(LENGTH "${hex}" length)
        math(EXPR missing "(16 - ${length} % 16) % 16")
        string(REPEAT "0" ${missing} padding)
        string(APPEND hex "${padding}")
        set(byte "[0-9a-f][0-9a-f]")
        string(REGEX REPLACE "(${byte}${byte}${byte}${byte}${byte}${byte}${byte}${byte})" "0x\\1," words "${hex}")
        set(word "0x[0-9a-f]+,")
        string(REGEX REPLACE "(${word}${word}${word}${word}${word})" "\\1\n            " words "${words}")
        string(REPLACE ",0x" ", 0x" words "${words}")
        string(REGEX REPLACE ",(\n            )?$" "" words "${words}")
        set(body "\n            ${words}\n        ")
    endif()
    set(${out_size} ${size} PARENT_SCOPE)
    set(${out_count} ${count} PARENT_SCOPE)
    set(${out_body} "${body}" PARENT_SCOPE)
endfunction()

set(routes "")
set(declarations "")
set(index 0)
foreach(path IN LISTS paths)
    if(path STREQUAL "")
        continue()
    endif()
    if(NOT EXISTS "${DIRECTORY}/${path}")
        message(FATAL_ERROR "${DIRECTORY}/${path} disappeared; configure the project again")
    endif()
    _webfront_render_words("${DIRECTORY}/${path}" size count body)
    # Appended as strings: the semicolons of C++ would split a CMake list.
    string(APPEND routes "        if (name == \"${path}\")\n            return ::webfront::fs::File{Asset${index}{}};\n")
    string(APPEND declarations "    struct Asset${index} {  // ${path}
        static constexpr ::std::size_t dataSize{${size}};
        static constexpr ::std::array<::std::uint64_t, ${count}> data{${body}};
    };\n")
    math(EXPR index "${index} + 1")
endforeach()

set(contents "// Generated by webfront_embed_directory() from ${DIRECTORY}: do not edit, the build regenerates it.
#pragma once

#include <webfront/system/FileSystem.hpp>

#include <array>
#include <cstddef>
#include <cstdint>
#include <filesystem>
#include <optional>
#include <string>

// Every name from outside is qualified from the global namespace: a class or a namespace of the application named std or
// webfront must not capture it.
namespace ${NAMESPACE} {

/// The ${index} files of ${DIRECTORY}, served by their path relative to it (identity encoded).
class ${CLASS} {
public:
    explicit ${CLASS}(::std::filesystem::path) { }
    static ::std::optional<::webfront::fs::File> open(::std::filesystem::path path) {
        const auto name = path.relative_path().generic_string();
${routes}        return {};
    }

private:
${declarations}};

}  // namespace ${NAMESPACE}
")

# Rewritten on every run, so that its time tells the build tool the header is current. A build tree header needs no fixed
# line ends, and file(WRITE) substitutes nothing in the paths it names.
file(WRITE "${OUTPUT}" "${contents}")
