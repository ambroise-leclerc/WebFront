{
  "schema": 1,
  "comment": "The local CI matrix (#346): one entry per lane the GitHub workflows expand to. test/cmake/CheckLocalCi.cmake fails when it drifts from .github/workflows.",
  "mddlog": {
    "repository": "ambroise-leclerc/mddlog",
    "ref": "5b43265664d83c3b7135d328f611e685792a1b02",
    "cmake_window": "4.0 to 4.3"
  },
  "workflows": {
    "BuildAndTest.yml": {
      "jobs": ["desktop", "sanitizers", "web-integration"],
      "matrices": {
        "desktop": {"key": "platform", "values": ["linux-gcc-webkitgtk", "windows-msvc-webview2", "macos-clang-wkwebview"]},
        "sanitizers": {"key": "sanitizer", "values": ["address-undefined", "thread"]},
        "web-integration": {"key": "compiler", "values": ["gcc", "clang"]}
      }
    },
    "MddlogIntegration.yml": {
      "jobs": ["clang", "sanitizers"],
      "matrices": {
        "sanitizers": {"key": "name", "values": ["address-undefined", "thread"]}
      }
    }
  },
  "local_differences": {
    "parallelism": "GitHub builds with --parallel 2; local lanes use the jobs limit of the machine (4 compilations on Windows).",
    "cache": "GitHub restores actions/cache and sccache; local lanes keep persistent CPM_SOURCE_CACHE and ccache volumes.",
    "toolchain": "GitHub installs toolchains per run; local machines are prepared once (docs/LOCAL_CI.md).",
    "runner_images": "ubuntu-26.04, ubuntu-24.04, windows-2025 and macos-26 runner images are replaced by pinned containers and the host systems.",
    "github_only_steps": [
      "actions/upload-artifact (logs are collected by the orchestrator)",
      "mozilla-actions/sccache-action (ccache replaces sccache)",
      "actions/cache",
      "Collect coverage upload (no Codecov step exists in the workflows; coverage.info and lcov --list stay local)",
      "Cut the public network: applied to the lane container instead of the host firewall"
    ]
  },
  "lanes": [
