# Select only installed GPUs for which nvcc can emit native machine code. A matching cubin avoids depending on the
# driver's PTX compiler, which may be older than the toolkit. Empty means detection could not make a safe choice.
function(webfront_cuda_native_architectures devices compiler_codes output)
    string(REPLACE "\r" "" devices "${devices}")
    string(REPLACE "\n" ";" devices "${devices}")
    string(REPLACE "\r" "" compiler_codes "${compiler_codes}")
    string(REPLACE "\n" ";" compiler_codes "${compiler_codes}")
    set(architectures)
    foreach(device IN LISTS devices)
        string(STRIP "${device}" device)
        if(device MATCHES "^([0-9]+)\\.([0-9]+)$")
            set(arch "${CMAKE_MATCH_1}${CMAKE_MATCH_2}")
            if("sm_${arch}" IN_LIST compiler_codes)
                list(APPEND architectures "${arch}")
            endif()
        endif()
    endforeach()
    list(REMOVE_DUPLICATES architectures)
    set(${output} "${architectures}" PARENT_SCOPE)
endfunction()

function(webfront_cuda_detect_native compiler output)
    set(${output} "" PARENT_SCOPE)
    if(CMAKE_CROSSCOMPILING)
        return()
    endif()
    find_program(_webfront_nvidia_smi NAMES nvidia-smi)
    if(NOT _webfront_nvidia_smi)
        return()
    endif()
    execute_process(COMMAND "${_webfront_nvidia_smi}" --query-gpu=compute_cap --format=csv,noheader
        RESULT_VARIABLE device_result OUTPUT_VARIABLE devices ERROR_QUIET TIMEOUT 5)
    execute_process(COMMAND "${compiler}" --list-gpu-code
        RESULT_VARIABLE compiler_result OUTPUT_VARIABLE codes ERROR_QUIET TIMEOUT 5)
    if(device_result STREQUAL "0" AND compiler_result STREQUAL "0")
        webfront_cuda_native_architectures("${devices}" "${codes}" architectures)
        set(${output} "${architectures}" PARENT_SCOPE)
    endif()
endfunction()

function(webfront_cuda_select_default explicit_choice compiler)
    if(explicit_choice OR CMAKE_CROSSCOMPILING)
        return()
    endif()
    webfront_cuda_detect_native("${compiler}" architectures)
    if(architectures)
        set(CMAKE_CUDA_ARCHITECTURES "${architectures}" CACHE STRING "CUDA architectures" FORCE)
        set(CMAKE_CUDA_ARCHITECTURES "${architectures}" PARENT_SCOPE)
        message(STATUS "Host-loop example: native CUDA architectures ${architectures}")
    endif()
endfunction()
