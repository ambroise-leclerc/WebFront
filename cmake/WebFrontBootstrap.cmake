# Bootstrap environment used to test WebFront: the pinned archive wf runs from, provisioned at configure time.
#
# It is distinct from include/webfront/system/DeveloperReleaseData.hpp (the environment applications start from) and is
# updated by an explicit pull request, once a published environment can build and test itself without interaction.
# 0.6.0 is the first published environment that runs a wf command without interaction (runNonInteractive); 0.6.1 also returns the
# output of a script, 0.6.2 reads the archives of @types packages and a manifest directory chosen by the application, and
# 0.6.3 exports the automation API v1, 0.6.4 adds the project setup operations of the automation runner and 0.6.5 is the
# first served from https://dist.webfront.fr/ (ADR-021).
# The driver tests also
# run the environment built from the current sources (the "environment under test"), which may be ahead of this pin.
set(WEBFRONT_BOOTSTRAP_VERSION "0.6.5")
set(WEBFRONT_BOOTSTRAP_URL "https://dist.webfront.fr/developer/0.6.5/environment.tgz")
set(WEBFRONT_BOOTSTRAP_INTEGRITY "sha512-qaSYOJvxcXtKIbrjfjZFFvfoQrda5NfBq24ttQ7SdnIN12tXFDYXRVe+JkrUHXZY6KOhF7qxmo4k8NOqLOupPA==")

# A directory holding environment.tgz (the pinned archive) replaces the download on a machine without network access.
set(WEBFRONT_BOOTSTRAP_DIR "" CACHE PATH "Directory with the pinned bootstrap environment.tgz, instead of downloading it")

# The verified downloads of the configure, kept once per machine: a new build tree links them instead of downloading them
# again. WEBFRONT_DOWNLOAD_CACHE or CPM's cache chooses the place; WebFront's own build otherwise uses the user's cache
# directory, and a project that consumes WebFront keeps each download in its build tree unless it asks. Empty disables it.
get_filename_component(_webfront_source "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(_webfront_download_cache "")
if(DEFINED ENV{WEBFRONT_DOWNLOAD_CACHE})
    set(_webfront_download_cache "$ENV{WEBFRONT_DOWNLOAD_CACHE}")
elseif(DEFINED ENV{CPM_SOURCE_CACHE})
    set(_webfront_download_cache "$ENV{CPM_SOURCE_CACHE}/webfront-downloads")
elseif(NOT CMAKE_SOURCE_DIR STREQUAL _webfront_source)
    # A consuming project: each download stays in its build tree.
elseif(CMAKE_HOST_WIN32 AND DEFINED ENV{LOCALAPPDATA})
    set(_webfront_download_cache "$ENV{LOCALAPPDATA}/WebFront/downloads")
elseif(CMAKE_HOST_APPLE AND DEFINED ENV{HOME})
    set(_webfront_download_cache "$ENV{HOME}/Library/Caches/WebFront/downloads")
elseif(DEFINED ENV{XDG_CACHE_HOME})
    set(_webfront_download_cache "$ENV{XDG_CACHE_HOME}/webfront/downloads")
elseif(DEFINED ENV{HOME})
    set(_webfront_download_cache "$ENV{HOME}/.cache/webfront/downloads")
endif()
set(WEBFRONT_DOWNLOAD_CACHE "${_webfront_download_cache}" CACHE PATH "Directory keeping the verified configure downloads for every build tree (empty: none)")
# A download that fails is tried again, WEBFRONT_DOWNLOAD_ATTEMPTS times in all, WEBFRONT_DOWNLOAD_RETRY_DELAY seconds apart.
if(NOT DEFINED WEBFRONT_DOWNLOAD_ATTEMPTS)
    set(WEBFRONT_DOWNLOAD_ATTEMPTS 3)
endif()
if(NOT DEFINED WEBFRONT_DOWNLOAD_RETRY_DELAY)
    set(WEBFRONT_DOWNLOAD_RETRY_DELAY 5)
endif()

# Sets <output> to TRUE when a file can be created in <directory>, which is created when missing. An existing directory
# may still refuse files (a read-only cache, a mount of another user's): a probe file tells.
function(_webfront_writable_directory directory output)
    set(${output} FALSE PARENT_SCOPE)
    file(MAKE_DIRECTORY "${directory}" RESULT made)
    if(NOT made EQUAL 0)
        return()
    endif()
    string(RANDOM LENGTH 12 suffix)
    set(probe "${directory}/.webfront-probe-${suffix}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E touch "${probe}" RESULT_VARIABLE touched OUTPUT_QUIET ERROR_QUIET)
    if(touched EQUAL 0 AND EXISTS "${probe}")
        file(REMOVE "${probe}")
        set(${output} TRUE PARENT_SCOPE)
    endif()
endfunction()

# webfront_download_verified(<path> URL <url> SHA512 <hex> FAILURE <text> MISMATCH <text>): makes <path> a file whose SHA-512
# is <hex>. A file already there with that digest is kept. Otherwise the machine's download cache provides it, a download
# filling the cache first; <path> is then a link to the cached file, or a copy where a link cannot be made. A download that
# fails is tried again; when it still fails, the configure stops with FAILURE and the reason, and with MISMATCH when the
# data it brought has another digest. No file without the expected digest is ever left at <path> or in the cache.
function(webfront_download_verified path)
    cmake_parse_arguments(ARG "" "URL;SHA512;FAILURE;MISMATCH" "" ${ARGN})
    if(EXISTS "${path}")
        file(SHA512 "${path}" actual)
        if(actual STREQUAL ARG_SHA512)
            return()
        endif()
        file(REMOVE "${path}")
    endif()
    get_filename_component(name "${path}" NAME)
    get_filename_component(destination "${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${destination}")
    set(target "${path}")
    if(WEBFRONT_DOWNLOAD_CACHE)
        # The first half of the digest names the entry: two files of the same name and version never meet.
        string(SUBSTRING "${ARG_SHA512}" 0 32 key)
        set(entry "${WEBFRONT_DOWNLOAD_CACHE}/${key}/${name}")
        # A verified entry serves even a cache that cannot be written, such as a shared read-only one.
        if(EXISTS "${entry}")
            file(SHA512 "${entry}" actual)
            if(actual STREQUAL ARG_SHA512)
                file(CREATE_LINK "${entry}" "${path}" COPY_ON_ERROR)
                return()
            endif()
        endif()
        # A download fills the cache only where a file can be created; a damaged entry is replaced once verified.
        _webfront_writable_directory("${WEBFRONT_DOWNLOAD_CACHE}/${key}" writable)
        if(writable)
            set(target "${entry}")
        else()
            message(WARNING "The download cache ${WEBFRONT_DOWNLOAD_CACHE} cannot be written: ${name} is kept in the build tree only")
        endif()
    endif()
    set(present FALSE)
    foreach(attempt RANGE 1 ${WEBFRONT_DOWNLOAD_ATTEMPTS})
        # Written aside, then renamed once verified: a concurrent configure never reads a partial file.
        string(RANDOM LENGTH 12 suffix)
        set(partial "${target}.${suffix}.partial")
        file(DOWNLOAD "${ARG_URL}" "${partial}" STATUS result TLS_VERIFY ON INACTIVITY_TIMEOUT 60 TIMEOUT 600)
        list(GET result 0 code)
        if(code EQUAL 0)
            file(SHA512 "${partial}" actual)
            if(NOT actual STREQUAL ARG_SHA512)
                file(REMOVE "${partial}")
                message(FATAL_ERROR "${ARG_MISMATCH}")
            endif()
            file(RENAME "${partial}" "${target}")
            set(present TRUE)
            break()
        endif()
        file(REMOVE "${partial}")
        list(GET result 1 reason)
        if(attempt LESS WEBFRONT_DOWNLOAD_ATTEMPTS)
            message(STATUS "Download of ${ARG_URL} failed (${reason}); trying again in ${WEBFRONT_DOWNLOAD_RETRY_DELAY} s")
            execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep ${WEBFRONT_DOWNLOAD_RETRY_DELAY})
        endif()
    endforeach()
    if(NOT present)
        message(FATAL_ERROR "${ARG_FAILURE}: ${reason} (${WEBFRONT_DOWNLOAD_ATTEMPTS} attempts)")
    endif()
    if(NOT target STREQUAL path)
        file(CREATE_LINK "${target}" "${path}" COPY_ON_ERROR)
    endif()
endfunction()

# Converts a base64 value to lowercase hexadecimal bytes.
function(webfront_base64_to_hex value output)
    set(alphabet "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    string(LENGTH "${value}" length)
    math(EXPR remainder "${length} % 4")
    if(NOT remainder EQUAL 0)
        message(FATAL_ERROR "Invalid base64 value (length ${length})")
    endif()
    set(hex "")
    math(EXPR last "${length} - 1")
    foreach(start RANGE 0 ${last} 4)
        set(group 0)
        set(padding 0)
        foreach(offset RANGE 0 3)
            math(EXPR position "${start} + ${offset}")
            string(SUBSTRING "${value}" ${position} 1 character)
            if(character STREQUAL "=")
                math(EXPR padding "${padding} + 1")
                set(sextet 0)
            else()
                string(FIND "${alphabet}" "${character}" sextet)
                if(sextet EQUAL -1)
                    message(FATAL_ERROR "Invalid base64 character '${character}'")
                endif()
            endif()
            math(EXPR group "(${group} << 6) | ${sextet}")
        endforeach()
        math(EXPR bytes "3 - ${padding}")
        foreach(index RANGE 0 ${bytes})
            if(index EQUAL bytes)
                break()
            endif()
            math(EXPR shift "16 - 8 * ${index}")
            math(EXPR byte "(${group} >> ${shift}) & 255" OUTPUT_FORMAT HEXADECIMAL)
            string(SUBSTRING "${byte}" 2 -1 digits)
            string(LENGTH "${digits}" digitCount)
            if(digitCount EQUAL 1)
                set(digits "0${digits}")
            endif()
            string(APPEND hex "${digits}")
        endforeach()
    endforeach()
    set(${output} "${hex}" PARENT_SCOPE)
endfunction()

# The hexadecimal SHA-512 of an SRI value ("sha512-<base64>").
function(webfront_sri_to_sha512 integrity output)
    if(NOT integrity MATCHES "^sha512-([A-Za-z0-9+/]+=*)$")
        message(FATAL_ERROR "Bootstrap integrity must be a sha512- SRI value: '${integrity}'")
    endif()
    webfront_base64_to_hex("${CMAKE_MATCH_1}" hex)
    string(LENGTH "${hex}" length)
    if(NOT length EQUAL 128)
        message(FATAL_ERROR "Bootstrap integrity is not a SHA-512 digest")
    endif()
    set(${output} "${hex}" PARENT_SCOPE)
endfunction()

# Makes <archive> the verified path of an environment archive: <LOCAL_DIR>/<name> when LOCAL_DIR is given, else the
# download of URL into DESTINATION (reused when it already matches). A wrong digest or a missing file stops the configure.
function(webfront_provision_bootstrap archive)
    cmake_parse_arguments(ARG "" "URL;INTEGRITY;DESTINATION;LOCAL_DIR" "" ${ARGN})
    webfront_sri_to_sha512("${ARG_INTEGRITY}" expected)
    get_filename_component(name "${ARG_URL}" NAME)
    if(ARG_LOCAL_DIR)
        set(path "${ARG_LOCAL_DIR}/${name}")
        if(NOT EXISTS "${path}")
            message(FATAL_ERROR "Bootstrap environment ${path} is missing: WEBFRONT_BOOTSTRAP_DIR must hold ${name}")
        endif()
    else()
        set(path "${ARG_DESTINATION}/${name}")
        webfront_download_verified("${path}" URL "${ARG_URL}" SHA512 "${expected}"
            FAILURE "Cannot download the bootstrap environment ${ARG_URL}. Provision it with -DWEBFRONT_BOOTSTRAP_DIR=<directory holding ${name}>"
            MISMATCH "Bootstrap environment integrity check failed for ${ARG_URL}: expected ${ARG_INTEGRITY}")
    endif()
    file(SHA512 "${path}" actual)
    if(NOT actual STREQUAL expected)
        if(NOT ARG_LOCAL_DIR)
            file(REMOVE "${path}")
        endif()
        message(FATAL_ERROR "Bootstrap environment integrity check failed for ${path}: expected ${ARG_INTEGRITY}")
    endif()
    set(${archive} "${path}" PARENT_SCOPE)
endfunction()

# The SRI value ("sha512-<base64>") of a file, for archives a test builds itself.
function(webfront_file_sri file output)
    file(SHA512 "${file}" hex)
    set(alphabet "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/")
    string(LENGTH "${hex}" length)
    set(encoded "")
    foreach(start RANGE 0 ${length} 6)
        if(start GREATER_EQUAL length)
            break()
        endif()
        math(EXPR remaining "(${length} - ${start}) / 2")
        string(SUBSTRING "${hex}" ${start} 6 digits)
        string(LENGTH "${digits}" digitCount)
        string(APPEND digits "000000")
        string(SUBSTRING "${digits}" 0 6 digits)
        math(EXPR group "0x${digits}")
        set(characters 4)
        if(remaining EQUAL 1)
            set(characters 2)
        elseif(remaining EQUAL 2)
            set(characters 3)
        endif()
        foreach(index RANGE 0 3)
            math(EXPR shift "18 - 6 * ${index}")
            math(EXPR sextet "(${group} >> ${shift}) & 63")
            if(index LESS characters)
                string(SUBSTRING "${alphabet}" ${sextet} 1 character)
            else()
                set(character "=")
            endif()
            string(APPEND encoded "${character}")
        endforeach()
    endforeach()
    set(${output} "sha512-${encoded}" PARENT_SCOPE)
endfunction()
