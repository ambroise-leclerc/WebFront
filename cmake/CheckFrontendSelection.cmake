# Configure-only fixtures exercise CTest commands on every platform and adding an engine using
# only a registration and support module. They need neither a compiler nor a browser SDK.
foreach(case cef-linux cef-macos cef-windows cef-disabled missing-xvfb missing-xvfb-hook browser webview2-windows extension)
    # These directories belong only to this configure-only fixture. Drop their caches so a
    # changed generator or previous discovery result cannot influence the next invocation.
    file(REMOVE_RECURSE "${CMAKE_CURRENT_BINARY_DIR}/frontend-tests/${case}")
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -S "${ROOT}/test/frontends" -B "${CMAKE_CURRENT_BINARY_DIR}/frontend-tests/${case}"
            -DROOT=${ROOT} -DCASE=${case}
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        list(APPEND failures "${case}: ${output}${error}")
    else()
        if(case MATCHES "^cef-(macos|windows)$" AND NOT "${output}${error}" MATCHES "browser integration is not registered on")
            list(APPEND failures "${case}: missing warning about unvalidated browser tests")
        endif()
        webfront_read_frontend_tests("${CMAKE_CURRENT_BINARY_DIR}/frontend-tests/${case}" tests)
        string(JSON count LENGTH "${tests}" tests)
        if(case STREQUAL "missing-xvfb-hook")
            if(NOT count EQUAL 1)
                list(APPEND failures "${case}: expected the independent lifecycle test, got ${count} tests")
            else()
                string(JSON name GET "${tests}" tests 0 name)
                if(NOT name STREQUAL "EngineLifecycle")
                    list(APPEND failures "${case}: expected EngineLifecycle, got '${name}'")
                endif()
            endif()
            continue()
        endif()
        if(case MATCHES "^(cef-macos|cef-windows|cef-disabled|missing-xvfb|browser)$")
            if(NOT count EQUAL 0)
                list(APPEND failures "${case}: expected no browser tests, got ${count}")
            endif()
            continue()
        endif()
        if(case STREQUAL "extension" OR case STREQUAL "webview2-windows")
            set(expected_count 9)
        else()
            set(expected_count 8)
        endif()
        if(NOT count EQUAL expected_count)
            list(APPEND failures "${case}: expected ${expected_count} tests, got ${count}")
            continue()
        endif()
        # Check every command, including the scenario argument on the shared runner.
        math(EXPR last_test "${count} - 1")
        foreach(test_index RANGE 0 ${last_test})
            string(JSON test_name GET "${tests}" tests ${test_index} name)
            if(test_name STREQUAL "EngineLifecycle")
                continue()
            endif()
            set(expected_command "${CMAKE_COMMAND}")
            if(case STREQUAL "cef-linux" OR case STREQUAL "extension")
                set(expected_command "${CMAKE_COMMAND};-a;${CMAKE_COMMAND}")
            endif()
            if(test_name MATCHES "Lifecycle-(.+)$")
                list(APPEND expected_command "${CMAKE_MATCH_1}")
            endif()
            list(LENGTH expected_command expected_length)
            string(JSON command_length LENGTH "${tests}" tests ${test_index} command)
            if(NOT command_length EQUAL expected_length)
                list(APPEND failures "${case}/${test_name}: expected ${expected_length} command tokens, got ${command_length}")
                continue()
            endif()
            math(EXPR last "${command_length} - 1")
            foreach(index RANGE 0 ${last})
                string(JSON token GET "${tests}" tests ${test_index} command ${index})
                list(GET expected_command ${index} expected)
                if(NOT token STREQUAL expected)
                    list(APPEND failures "${case}/${test_name}: command token ${index}: expected '${expected}', got '${token}'")
                endif()
            endforeach()
        endforeach()
    endif()
endforeach()

if(failures)
    list(JOIN failures "\n" text)
    message(FATAL_ERROR "Frontend selection regressions:\n${text}")
endif()
