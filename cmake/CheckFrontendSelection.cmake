# Exercises cmake/Frontends.cmake: registered names, defaults, rejection of unknown or unavailable
# frontends and the generated C++ type name. Each case runs in its own cmake -P process so that a
# FATAL_ERROR can be observed. Run with:
#   cmake -DROOT=<checkout> -P cmake/CheckFrontendSelection.cmake
cmake_minimum_required(VERSION 3.31)

if(NOT ROOT)
    message(FATAL_ERROR "ROOT must point at the WebFront checkout")
endif()

if(CASE)
    if(CASE STREQUAL "cross-root")
        set(CMAKE_FIND_ROOT_PATH "${CMAKE_CURRENT_BINARY_DIR}/empty-frontend-sysroot")
        set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
    endif()
    if(CASE STREQUAL "parent-shadow")
        set(parent_modules "${CMAKE_CURRENT_BINARY_DIR}/frontend-tests/parent-modules")
        file(MAKE_DIRECTORY "${parent_modules}")
        foreach(module CEFIntegration WebView2Support)
            file(WRITE "${parent_modules}/${module}.cmake" "message(FATAL_ERROR \"Parent module must not shadow WebFront\")\n")
        endforeach()
        list(PREPEND CMAKE_MODULE_PATH "${parent_modules}")
    endif()
    list(APPEND CMAKE_MODULE_PATH "${ROOT}/test/frontends")
    include("${ROOT}/cmake/Frontends.cmake")
    # Unquoted empty inputs intentionally unset these variables so option() supplies its default.
    set(WEBFRONT_EMBED_CEF ${CEF})
    set(WEBFRONT_EMBED_WEBVIEW2 ${WEBVIEW2})
    if(CASE STREQUAL "options" OR CASE STREQUAL "cross-root")
        webfront_declare_frontend_options()
        foreach(name IN LISTS WEBFRONT_FRONTEND_REGISTRY)
            set(option "${WEBFRONT_FRONTEND_${name}_OPTION}")
            if(NOT option STREQUAL "")
                get_property(value CACHE ${option} PROPERTY VALUE)
                get_property(help CACHE ${option} PROPERTY HELPSTRING)
                if(NOT help STREQUAL WEBFRONT_FRONTEND_${name}_DESCRIPTION)
                    message(FATAL_ERROR "${option} help text differs from its registration")
                endif()
                message("OPTION=${option}:${value}")
            endif()
        endforeach()
    elseif(CASE STREQUAL "parent-shadow")
        foreach(name CEF WebView2)
            if(NOT WEBFRONT_FRONTEND_${name}_SUPPORT_FILE STREQUAL "${ROOT}/cmake/${WEBFRONT_FRONTEND_${name}_SUPPORT}.cmake")
                message(FATAL_ERROR "${name} support was shadowed by a parent module")
            endif()
        endforeach()
        message("OWN_MODULES=OK")
    elseif(CASE STREQUAL "invalid-name")
        webfront_register_frontend("${VALUE}" ALWAYS_AVAILABLE)
    elseif(CASE STREQUAL "cached-selection")
        set(WEBFRONT_EMBED_CEF ON)
        set(WEBFRONT_EMBED_WEBVIEW2 OFF)
        webfront_default_embedded_frontend(default FALLBACK CEF)
        webfront_select_frontend(TEST_SELECTOR "${default}" "Test")
        set(WEBFRONT_EMBED_WEBVIEW2 ON)
        webfront_default_embedded_frontend(default FALLBACK CEF)
        webfront_select_frontend(TEST_SELECTOR "${default}" "Test")
        if(NOT default STREQUAL "WebView2" OR NOT TEST_SELECTOR STREQUAL "CEF")
            message(FATAL_ERROR "Reconfiguration must preserve the existing selector cache")
        endif()
        set(TEST_SELECTOR WebView2 CACHE STRING "Test" FORCE)
        webfront_select_frontend(TEST_SELECTOR "${default}" "Test")
        if(NOT TEST_SELECTOR_TYPE STREQUAL "webfront::frontend::WebView2Frontend")
            message(FATAL_ERROR "An explicit cache override must take effect")
        endif()
        message("CACHE_SELECTION=OK")
    elseif(CASE STREQUAL "browser-field")
        if(VALUE STREQUAL "valid")
            webfront_register_frontend(TestBrowser ALWAYS_AVAILABLE)
            if(NOT WEBFRONT_FRONTEND_TestBrowser_POLICY STREQUAL "lenient")
                message(FATAL_ERROR "ALWAYS_AVAILABLE must default to POLICY lenient")
            endif()
            webfront_select_frontend(TEST_BROWSER TestBrowser "Test always-available browser")
            message("TYPE=${TEST_BROWSER_TYPE}")
        elseif(VALUE STREQUAL "strict")
            webfront_register_frontend(TestBrowser ALWAYS_AVAILABLE POLICY strict)
            webfront_select_frontend(TEST_BROWSER TestBrowser "Test always-available browser" REQUIRE_AVAILABLE)
        elseif(VALUE STREQUAL "XVFB_LINUX")
            webfront_register_frontend(TestBrowser ALWAYS_AVAILABLE XVFB_LINUX)
        else()
            webfront_register_frontend(TestBrowser ALWAYS_AVAILABLE ${VALUE} ignored)
        endif()
    elseif(CASE STREQUAL "hooks")
        set(WEBFRONT_EMBED_CEF OFF)
        set(WEBFRONT_EMBED_WEBVIEW2 OFF)
        webfront_register_frontend(TestEngine OPTION WEBFRONT_EMBED_TEST POLICY strict DESCRIPTION "Test engine"
            PLATFORMS Linux SUPPORT TestSupport TEST_PLATFORMS Linux TEST_NAME TestIntegration TEST_TIMEOUT 42
            ${VALUE} missing_test_hook)
        set(WEBFRONT_EMBED_TEST ON)
        webfront_include_frontend_support()
    elseif(CASE STREQUAL "register")
        if(VALUE STREQUAL "duplicate")
            webfront_register_frontend(CEF POLICY lenient)
        else()
            set(field_OPTION WEBFRONT_EMBED_TEST)
            set(field_POLICY strict)
            set(field_DESCRIPTION "Test engine")
            set(field_PLATFORMS Linux)
            set(field_SUPPORT TestSupport)
            set(field_TEST_PLATFORMS Linux)
            set(field_TEST_NAME TestIntegration)
            set(field_TEST_TIMEOUT 42)
            set(fields OPTION POLICY DESCRIPTION PLATFORMS SUPPORT TEST_PLATFORMS TEST_NAME TEST_TIMEOUT)

            # Each invalid-value case names the field it changes; no coupling to default literals.
            set(overrides
                "invalid-timeout|TEST_TIMEOUT|zero"
                "zero-timeout|TEST_TIMEOUT|0"
                "negative-timeout|TEST_TIMEOUT|-1"
                "missing-module|SUPPORT|MissingSupportModule"
                "invalid-policy|POLICY|unknown"
                "invalid-option|OPTION|ENABLE_TEST_ENGINE"
                "unsupported-test-platform|TEST_PLATFORMS|Windows")
            foreach(override IN LISTS overrides)
                string(REPLACE "|" ";" parts "${override}")
                list(GET parts 0 case_name)
                if(VALUE STREQUAL case_name)
                    list(GET parts 1 field)
                    list(GET parts 2 value)
                    set(field_${field} "${value}")
                endif()
            endforeach()
            if(VALUE IN_LIST fields)
                unset(field_${VALUE})
            endif()
            set(args "")
            foreach(field IN LISTS fields)
                if(DEFINED field_${field})
                    list(APPEND args "${field}" "${field_${field}}")
                endif()
            endforeach()
            if(VALUE STREQUAL "always-and-option")
                list(APPEND args ALWAYS_AVAILABLE)
            elseif(VALUE STREQUAL "unknown-field")
                list(APPEND args UNKNOWN value)
            elseif(VALUE STREQUAL "missing-value")
                list(APPEND args SETUP)
            endif()
            webfront_register_frontend(TestEngine ${args})
        endif()
    elseif(CASE STREQUAL "default")
        webfront_default_embedded_frontend(chosen FALLBACK CEF)
        message("CHOSEN=${chosen}")
    elseif(CASE STREQUAL "select")
        set(WEBFRONT_TEST_SELECTOR "${VALUE}")
        webfront_select_frontend(WEBFRONT_TEST_SELECTOR DefaultBrowser "Test" ${FLAGS})
        message("TYPE=${WEBFRONT_TEST_SELECTOR_TYPE}")
    endif()
    return()
endif()

include("${ROOT}/cmake/FrontendTestHelpers.cmake")

set(failures "")
function(run_case name expect_success expected_text)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -DROOT=${ROOT} -DCASE=${CASE_NAME} -DCMAKE_SYSTEM_NAME=${CASE_PLATFORM} -DCEF=${CASE_CEF} -DWEBVIEW2=${CASE_WEBVIEW2}
                -DVALUE=${CASE_VALUE} "-DFLAGS=${CASE_FLAGS}" -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(text "${output}${error}")
    if(expect_success AND NOT result EQUAL 0)
        list(APPEND failures "${name}: expected success, got: ${text}")
    elseif(NOT expect_success AND result EQUAL 0)
        list(APPEND failures "${name}: expected a configuration error, got: ${text}")
    endif()
    # CMake wraps diagnostics according to their length; match their content across line breaks.
    string(REGEX REPLACE "[ \t\r\n]+" " " normalized_text "${text}")
    if(NOT normalized_text MATCHES "${expected_text}")
        list(APPEND failures "${name}: '${text}' does not match '${expected_text}'")
    endif()
    set(failures "${failures}" PARENT_SCOPE)
endfunction()

