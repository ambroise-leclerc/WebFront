cmake_minimum_required(VERSION 3.31)

if(CASE)
    set(APPLE ON)
    set(CMAKE_CXX_COMPILER_ID AppleClang)
    if(CASE STREQUAL "platform")
        set(APPLE OFF)
    elseif(CASE STREQUAL "compiler")
        set(CMAKE_CXX_COMPILER_ID GNU)
    elseif(CASE STREQUAL "deployment")
        set(CMAKE_OSX_DEPLOYMENT_TARGET 13.2)
    elseif(CASE STREQUAL "supported")
        set(CMAKE_OSX_DEPLOYMENT_TARGET 13.3)
    endif()
    # Configure-only stand-ins: no macOS SDK or compiler is needed on other CI platforms.
    function(find_library name framework)
        set(${name} "${framework}.framework" PARENT_SCOPE)
    endfunction()
    function(target_compile_definitions target scope value)
        if(NOT target STREQUAL "WebFront" OR NOT scope STREQUAL "INTERFACE" OR NOT value STREQUAL "WEBFRONT_EMBED_WKWEBVIEW")
            message(FATAL_ERROR "Unexpected compile definitions")
        endif()
    endfunction()
    function(target_compile_options target scope value)
        if(NOT scope STREQUAL "INTERFACE" OR NOT value STREQUAL "$<$<COMPILE_LANGUAGE:CXX>:-fblocks>")
            message(FATAL_ERROR "Missing transitive Blocks support")
        endif()
    endfunction()
    function(target_link_libraries target scope cocoa webkit)
        if(NOT scope STREQUAL "INTERFACE" OR NOT cocoa STREQUAL "Cocoa.framework" OR NOT webkit STREQUAL "WebKit.framework")
            message(FATAL_ERROR "Missing transitive Cocoa/WebKit frameworks")
        endif()
    endfunction()
    include("${ROOT}/cmake/WKWebViewSupport.cmake")
    message("SUPPORTED=OK")
    return()
endif()

foreach(case platform compiler deployment supported default-deployment)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DROOT=${ROOT} -DCASE=${case} -P "${CMAKE_CURRENT_LIST_FILE}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(case MATCHES "^(supported|default-deployment)$")
        if(NOT result EQUAL 0 OR NOT "${output}${error}" MATCHES "SUPPORTED=OK")
            message(FATAL_ERROR "WKWebView ${case}: ${output}${error}")
        endif()
    else()
        set(platform "supported only on macOS")
        set(compiler "requires Clang with Apple Blocks support")
        set(deployment "requires CMAKE_OSX_DEPLOYMENT_TARGET >= 13.3")
        string(REGEX REPLACE "[ \r\n\t]+" " " diagnostic "${output}${error}")
        string(FIND "${diagnostic}" "${${case}}" found)
        if(result EQUAL 0 OR found EQUAL -1)
            message(FATAL_ERROR "WKWebView ${case}: missing expected diagnostic: ${output}${error}")
        endif()
    endif()
endforeach()
