include_guard(GLOBAL)

find_package(PkgConfig QUIET)
if(NOT PkgConfig_FOUND)
    message(FATAL_ERROR "WEBFRONT_EMBED_WEBKITGTK=ON requires pkg-config and the WebKitGTK 6.0 development packages")
endif()
pkg_check_modules(WebKitGTK QUIET IMPORTED_TARGET GLOBAL webkitgtk-6.0)
if(NOT WebKitGTK_FOUND)
    message(FATAL_ERROR "WEBFRONT_EMBED_WEBKITGTK=ON requires pkg-config webkitgtk-6.0. Install libwebkitgtk-6.0-dev (Ubuntu/Debian) or webkitgtk6.0-devel (Fedora). GTK 3/WebKitGTK 4.0 and 4.1 are not supported.")
endif()
# The imported target verifies the installed SDK and is available to explicit native consumers.
# The adapter uses dlopen rather than linking GTK into all executables (including CEF subprocesses).
# Do not propagate its SDK include paths or GTK/GLib headers through WebFront.
target_compile_definitions(WebFront INTERFACE WEBFRONT_EMBED_WEBKITGTK)
target_link_libraries(WebFront INTERFACE ${CMAKE_DL_LIBS})

include("${CMAKE_CURRENT_LIST_DIR}/../test/cmake/WebKitGTKTestEnvironment.cmake")

function(webfront_add_webkitgtk_tests)
    foreach(name IN LISTS ARGN)
        webfront_configure_webkitgtk_test("${name}")
    endforeach()
    set(source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../test/web")
    add_executable(webkitgtk_lifecycle "${source}/WebKitGTKLifecycle.cpp")
    target_link_libraries(webkitgtk_lifecycle PRIVATE WebFront_test_hardening WebFront WebFront_warnings WebFront_options)
    add_dependencies(webtest webkitgtk_lifecycle)
    webfront_find_xvfb(display_runner)
    foreach(mode no-display worker-thread native-close repeated-show http-error pre-run-failure profile-permissions)
        if(mode MATCHES "^(no-display|worker-thread|pre-run-failure|profile-permissions)$")
            add_test(NAME WebKitGTKAdapter-${mode} COMMAND webkitgtk_lifecycle ${mode})
        elseif(display_runner)
            add_test(NAME WebKitGTKAdapter-${mode} COMMAND "${display_runner}" -a $<TARGET_FILE:webkitgtk_lifecycle> ${mode})
        else()
            continue()
        endif()
        webfront_set_browser_test_properties(WebKitGTKAdapter-${mode} "${source}" 60)
        webfront_configure_webkitgtk_test(WebKitGTKAdapter-${mode})
    endforeach()
    # Short direct-channel correctness checks; no measurement batches or reports.
    add_executable(webkitgtk_transport_contracts "${source}/WebKitGTKTransportBenchmark.cpp")
    target_compile_definitions(webkitgtk_transport_contracts PRIVATE WEBFRONT_TRANSPORT_CONTRACTS_ONLY)
    target_link_libraries(webkitgtk_transport_contracts PRIVATE WebFront WebFront_warnings WebFront_options)
    add_dependencies(webtest webkitgtk_transport_contracts)
    if(display_runner)
        add_test(NAME WebKitGTKTransportContracts COMMAND "${display_runner}" -a $<TARGET_FILE:webkitgtk_transport_contracts>)
    else()
        add_test(NAME WebKitGTKTransportContracts COMMAND webkitgtk_transport_contracts)
    endif()
    webfront_set_browser_test_properties(WebKitGTKTransportContracts "${source}" 60)
    webfront_configure_webkitgtk_test(WebKitGTKTransportContracts)
    # Manual measurement only: never built or run by CTest/CI.
    add_executable(webkitgtk_transport_benchmark EXCLUDE_FROM_ALL "${source}/WebKitGTKTransportBenchmark.cpp")
    target_link_libraries(webkitgtk_transport_benchmark PRIVATE WebFront WebFront_warnings WebFront_options)
    # ADR-018 (#378): throwaway DOM prototypes, manual measurement only. C++26 reflection when the compiler has it.
    add_executable(webkitgtk_dom_prototype EXCLUDE_FROM_ALL "${source}/dom/DomPrototype.cpp")
    target_link_libraries(webkitgtk_dom_prototype PRIVATE WebFront WebFront_warnings WebFront_options)
    include(CheckCXXCompilerFlag)
    check_cxx_compiler_flag("-std=c++26 -freflection" WEBFRONT_HAS_REFLECTION)
    if(WEBFRONT_HAS_REFLECTION)
        set_target_properties(webkitgtk_dom_prototype PROPERTIES CXX_STANDARD 26)
        target_compile_options(webkitgtk_dom_prototype PRIVATE -freflection)
    endif()
endfunction()
