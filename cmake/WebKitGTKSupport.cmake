include_guard(GLOBAL)

find_package(PkgConfig QUIET)
if(NOT PkgConfig_FOUND)
    message(FATAL_ERROR "WEBFRONT_EMBED_WEBKITGTK=ON requires pkg-config and the WebKitGTK 6.0 development packages")
endif()
pkg_check_modules(WebKitGTK QUIET IMPORTED_TARGET GLOBAL webkitgtk-6.0)
if(NOT WebKitGTK_FOUND)
    message(FATAL_ERROR "WEBFRONT_EMBED_WEBKITGTK=ON requires pkg-config webkitgtk-6.0. Install libwebkitgtk-6.0-dev (Ubuntu/Debian) or webkitgtk6.0-devel (Fedora). GTK 3/WebKitGTK 4.0 and 4.1 are not supported.")
endif()
# The imported target verifies the installed SDK and is available to explicit native consumers.
# The adapter uses dlopen rather than linking GTK into all executables (including CEF subprocesses).
# Do not propagate its SDK include paths or GTK/GLib headers through WebFront.
target_compile_definitions(WebFront INTERFACE WEBFRONT_EMBED_WEBKITGTK)
target_link_libraries(WebFront INTERFACE ${CMAKE_DL_LIBS})

include("${CMAKE_CURRENT_LIST_DIR}/WebKitGTKTestEnvironment.cmake")

function(webfront_add_webkitgtk_tests)
    foreach(name IN LISTS ARGN)
        webfront_configure_webkitgtk_test("${name}")
    endforeach()
    set(source "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../webtest")
    add_executable(webkitgtk_lifecycle "${source}/WebKitGTKLifecycle.cpp")
    target_link_libraries(webkitgtk_lifecycle PRIVATE WebFront_test_hardening WebFront WebFront_warnings WebFront_options)
    add_dependencies(webtest webkitgtk_lifecycle)
    webfront_find_xvfb(display_runner)
    foreach(mode no-display worker-thread native-close repeated-show http-error pre-run-failure profile-permissions)
        if(mode MATCHES "^(no-display|worker-thread|pre-run-failure|profile-permissions)$")
            add_test(NAME WebKitGTKAdapter-${mode} COMMAND webkitgtk_lifecycle ${mode})
        elseif(display_runner)
            add_test(NAME WebKitGTKAdapter-${mode} COMMAND "${display_runner}" -a $<TARGET_FILE:webkitgtk_lifecycle> ${mode})
        else()
            continue()
        endif()
        webfront_set_browser_test_properties(WebKitGTKAdapter-${mode} "${source}" 60)
        webfront_configure_webkitgtk_test(WebKitGTKAdapter-${mode})
    endforeach()
endfunction()
