# Public, opt-in CTest support for a consumer's own page and callbacks.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Frontends.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/WebFrontBootstrap.cmake")
# Functions are also called by a parent project after add_subdirectory(WebFront); capture registry
# metadata explicitly because the internal frontend registry is scoped to the WebFront directory.
set_property(GLOBAL PROPERTY WEBFRONT_JASMINE_FRONTENDS "${WEBFRONT_FRONTEND_REGISTRY}")
foreach(engine IN LISTS WEBFRONT_FRONTEND_REGISTRY)
    foreach(field OPTION PLATFORMS)
        set_property(GLOBAL PROPERTY "WEBFRONT_JASMINE_${engine}_${field}" "${WEBFRONT_FRONTEND_${engine}_${field}}")
    endforeach()
endforeach()

function(_webfront_jasmine_quote value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

# webfront_add_jasmine_test(NAME name TARGET application SPECS files... [ARGS ...]
#     [FRONTEND engine] [TIMEOUT seconds] [JASMINE path/to/jasmine.js])
# TARGET must retain webfront::testing::JasmineTest before show() in its test-enabled build; the helper defines
# WEBFRONT_JASMINE_TESTING on it, and without that macro JasmineTest is inert. ARGS reach the application literally,
# as individual arguments (empty ones, semicolons and '$<' included).
function(webfront_add_jasmine_test)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "NAME;TARGET;FRONTEND;TIMEOUT;JASMINE" "SPECS;ARGS")
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES OR NOT ARG_NAME OR NOT ARG_TARGET OR NOT ARG_SPECS)
        message(FATAL_ERROR "webfront_add_jasmine_test requires NAME, TARGET, SPECS and valid named arguments")
    endif()
    if(NOT ARG_NAME MATCHES "^[A-Za-z0-9_-]+$")
        message(FATAL_ERROR "Jasmine NAME must contain only letters, digits, '_' and '-'")
    endif()
    if(NOT TARGET "${ARG_TARGET}")
        message(FATAL_ERROR "Jasmine TARGET '${ARG_TARGET}' does not exist")
    endif()
    get_target_property(kind "${ARG_TARGET}" TYPE)
    if(NOT kind STREQUAL "EXECUTABLE")
        message(FATAL_ERROR "Jasmine TARGET must be an executable")
    endif()
    list(LENGTH ARG_SPECS spec_count)
    if(spec_count GREATER 100)
        message(FATAL_ERROR "Jasmine supports at most 100 spec files, got ${spec_count}")
    endif()
    if(NOT ARG_TIMEOUT)
        set(ARG_TIMEOUT 60)
    endif()
    if(NOT ARG_TIMEOUT MATCHES "^[1-9][0-9]*$" OR ARG_TIMEOUT GREATER 3600)
        message(FATAL_ERROR "Jasmine TIMEOUT must be whole seconds from 1 to 3600")
    endif()
    if(ARG_FRONTEND)
        get_property(engines GLOBAL PROPERTY WEBFRONT_JASMINE_FRONTENDS)
        if(NOT ARG_FRONTEND IN_LIST engines OR ARG_FRONTEND STREQUAL "DefaultBrowser")
            message(FATAL_ERROR "Jasmine FRONTEND must name an embedded frontend")
        endif()
        get_property(platforms GLOBAL PROPERTY "WEBFRONT_JASMINE_${ARG_FRONTEND}_PLATFORMS")
        get_property(option GLOBAL PROPERTY "WEBFRONT_JASMINE_${ARG_FRONTEND}_OPTION")
        # The option property holds a variable name; an unset one must not break the condition's syntax.
        set(enabled OFF)
        if(option)
            if(${option})
                set(enabled ON)
            endif()
        endif()
        if(NOT CMAKE_SYSTEM_NAME IN_LIST platforms OR NOT enabled)
            message(FATAL_ERROR "Jasmine FRONTEND '${ARG_FRONTEND}' is not enabled on this platform")
        endif()
    endif()
    # Use the same pinned package and verifier as wf's registry, outside the core resources.
    if(NOT ARG_JASMINE)
        # Provision and extract once per directory, however many tests it registers.
        set(package "${CMAKE_CURRENT_BINARY_DIR}/webfront-jasmine/package")
        get_property(provisioned GLOBAL PROPERTY "WEBFRONT_JASMINE_PROVISIONED_${package}")
        if(NOT provisioned)
            webfront_provision_bootstrap(archive
                URL "https://registry.npmjs.org/jasmine-core/-/jasmine-core-7.0.2.tgz"
                INTEGRITY "sha512-YMVijt84KPQQFm1db1AQAxTXfq0k3wU06OkepLViljURFqiRQ7EYYX2eUAshhUv9fA9t1E2N65GrdqvupA9VPQ=="
                DESTINATION "${package}"
                LOCAL_DIR "${WEBFRONT_JASMINE_ARCHIVE_DIR}")
            file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${package}"
                PATTERNS "package/lib/jasmine-core/jasmine.js" "package/LICENSE")
            set_property(GLOBAL PROPERTY "WEBFRONT_JASMINE_PROVISIONED_${package}" TRUE)
        endif()
        set(ARG_JASMINE "${package}/package/lib/jasmine-core/jasmine.js")
    endif()
    set(files "[]")
    set(index 0)
    foreach(path IN ITEMS "${ARG_JASMINE}" ${ARG_SPECS})
        get_filename_component(path "${path}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_SOURCE_DIR}")
        if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
            message(FATAL_ERROR "Jasmine file not found: ${path}")
        endif()
        _webfront_jasmine_quote("${path}" quoted)
        string(JSON files SET "${files}" ${index} "${quoted}")
        math(EXPR index "${index} + 1")
    endforeach()
    set(directory "${CMAKE_CURRENT_BINARY_DIR}/webfront-jasmine/${ARG_NAME}")
    file(MAKE_DIRECTORY "${directory}")
    _webfront_jasmine_quote("${directory}/report.json" report)
    set(config "{}")
    string(JSON config SET "${config}" files "${files}")
    string(JSON config SET "${config}" report "${report}")
    file(WRITE "${directory}/config.json" "${config}\n")
    set(arguments "[]")
    set(index 0)
    foreach(argument IN LISTS ARG_ARGS)
        if(argument MATCHES "\\]==\\]")
            message(FATAL_ERROR "A Jasmine ARGS entry must not contain ']==]'")
        endif()
        # file(GENERATE) evaluates generator expressions: keep every argument literal.
        string(REPLACE "$<" "$<1:$><" argument "${argument}")
        _webfront_jasmine_quote("${argument}" quoted)
        string(JSON arguments SET "${arguments}" ${index} "${quoted}")
        math(EXPR index "${index} + 1")
    endforeach()
    file(GENERATE OUTPUT "${directory}/arguments-$<CONFIG>.json" CONTENT "${arguments}\n")
    set(prefix "")
    if(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND ARG_FRONTEND)
        find_program(_webfront_jasmine_xvfb xvfb-run REQUIRED)
        set(prefix "${_webfront_jasmine_xvfb}")
    endif()
    target_compile_definitions("${ARG_TARGET}" PRIVATE WEBFRONT_JASMINE_TESTING=1)
    add_test(NAME "${ARG_NAME}" COMMAND "${CMAKE_COMMAND}"
        "-DPROGRAM=$<TARGET_FILE:${ARG_TARGET}>" "-DDIRECTORY=${directory}" "-DCONFIG=$<CONFIG>"
        "-DPREFIX=${prefix}" "-DLIMIT=${ARG_TIMEOUT}"
        -P "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/RunWebFrontJasmine.cmake")
    math(EXPR outer_timeout "${ARG_TIMEOUT} + 15")
    set_tests_properties("${ARG_NAME}" PROPERTIES TIMEOUT "${outer_timeout}" LABELS "web-integration")
endfunction()
