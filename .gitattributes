# Auto detect text files and perform LF normalization
*          text=auto

# Documents and data
*.md       text diff=markdown
*.txt      text
*.csv      text
*.json     text
*.yml      text
*.yaml     text
*.toml     text
*.xml      text

# Graphics
*.png      binary
*.jpg      binary
*.jpeg     binary
*.gif      binary
*.ico      binary

# Archives
*.gz       binary
*.tgz      binary
*.zip      binary

# Sources
*.cpp      text diff=cpp
*.hpp      text diff=cpp
*.h        text diff=cpp

# Scripts. These are explicitly windows files and should use crlf
*.sh       text eol=lf
*.bat      text eol=crlf
*.cmd      text eol=crlf
*.ps1      text eol=crlf

# Exclude files from exporting
.gitattributes export-ignore
.gitignore     export-ignore
.gitkeep       export-ignore

# Embedded headers hold the exact bytes of their text sources. Freshness tests
# re-read those sources, so Windows checkouts must preserve LF for every asset.
js/core/WebFront.js                          text eol=lf
js/core/bootstrap/*                          text eol=lf
js/core/favicon.ico                          binary
include/webfront/system/WebFrontJsData.hpp           text eol=lf
js/core/fallback/index.html                  text eol=lf
js/core/fallback/webfront-fallback.mjs       text eol=lf
include/webfront/system/FallbackIndexHtmlData.hpp    text eol=lf
include/webfront/system/FallbackModuleData.hpp       text eol=lf

# Fuzzer seeds retain exact protocol bytes, including HTTP CRLF.
test/fuzz/corpus/** binary

# Generated dependency data keeps exact bytes on Windows.
include/webfront/system/*Data.hpp                   text eol=lf

# Browser-powered developer bootstrap sources and generated payloads.
js/developer/environment/*                          text eol=lf

# Starter archives and every hashed distribution input must be identical on Windows.
examples/life/ui/*                          text eol=lf
js/developer/tools/*                           text eol=lf

# The wf project of the repository: its scripts, manifest and lock are hashed inputs of the self-build.
js/developer/scripts/*                      text eol=lf
js/developer/webfront.project.json          text eol=lf
js/developer/webfront-packages.lock.json    text eol=lf
