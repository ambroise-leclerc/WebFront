# The structure of docs/CHANGELOG.md (#536), described in .github/CONTRIBUTING.md ("Changelog format"):
#   cmake -DROOT=<checkout> -P test/cmake/CheckChangelogFormat.cmake
# Every version has a dated heading, a summary before its first category, only the allowed categories in a fixed order
# (Breaking first), bounded entries, a comparison link at the foot and a detailed archive in docs/changelog/. An entry may
# wrap over continuation lines; the bound applies to the whole entry. From 0.7.0 on each entry ends with a reference
# (#NNN or a document); the older versions are condensed from their archive and cite it through their summary.
cmake_minimum_required(VERSION 3.31)

if(NOT ROOT)
    message(FATAL_ERROR "ROOT is required")
endif()

set(max_entry_chars 420)
set(max_recent_lines 50)
set(first_referenced_version 0.7.0)
set(categories Breaking Added Changed Fixed Security)

file(STRINGS "${ROOT}/docs/CHANGELOG.md" lines)

set(version "")
set(category "")
set(rank -1)
set(entry "")
set(versions "")
set(links "")
set(summary OFF)

function(check_entry)
    if(entry STREQUAL "")
        return()
    endif()
    string(LENGTH "${entry}" length)
    if(length GREATER max_entry_chars)
        message(FATAL_ERROR "CHANGELOG ${version}: entry of ${length} characters (limit ${max_entry_chars}); the detail belongs to its ADR or guide: ${entry}")
    endif()
    if(NOT version VERSION_LESS first_referenced_version AND NOT entry MATCHES "#[0-9]+|\\.md")
        message(FATAL_ERROR "CHANGELOG ${version}: entry without a reference (#NNN) or a document: ${entry}")
    endif()
endfunction()

foreach(line IN LISTS lines)
    if(line MATCHES "^## ")
        check_entry()
        set(entry "")
        set(category "")
        set(rank -1)
        set(summary OFF)
        if(line STREQUAL "## Unreleased")
            set(version "")
            set(in_unreleased ON)
            continue()
        endif()
        set(in_unreleased OFF)
        if(NOT line MATCHES "^## \\[([0-9]+\\.[0-9]+\\.[0-9]+)\\] - [0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]$")
            message(FATAL_ERROR "CHANGELOG: a version heading is '## [x.y.z] - YYYY-MM-DD': ${line}")
        endif()
        set(version "${CMAKE_MATCH_1}")
        list(APPEND versions "${version}")
        continue()
    endif()
    if(line MATCHES "^\\[([^]]+)\\]: https://")
        list(APPEND links "${CMAKE_MATCH_1}")
        continue()
    endif()
    if(version STREQUAL "")
        continue()
    endif()
    if(line MATCHES "^### (.+)$")
        check_entry()
        set(entry "")
        set(category "${CMAKE_MATCH_1}")
        list(FIND categories "${category}" index)
        if(index EQUAL -1)
            message(FATAL_ERROR "CHANGELOG ${version}: category '${category}' is not one of ${categories}")
        endif()
        if(index LESS rank)
            message(FATAL_ERROR "CHANGELOG ${version}: category '${category}' is out of order (${categories})")
        endif()
        set(rank ${index})
    elseif(line MATCHES "^- ")
        check_entry()
        if(category STREQUAL "")
            message(FATAL_ERROR "CHANGELOG ${version}: entry before any category: ${line}")
        endif()
        string(SUBSTRING "${line}" 2 -1 entry)
    elseif(line MATCHES "^  [^ ]" AND NOT entry STREQUAL "")
        string(STRIP "${line}" more)
        string(APPEND entry " ${more}")
    elseif(line STREQUAL "")
        check_entry()
        set(entry "")
    elseif(category STREQUAL "")
        set(summary ON)
        set(summary_${version} ON)
    endif()
endforeach()
check_entry()

if(NOT versions)
    message(FATAL_ERROR "CHANGELOG: no version found")
endif()

set(previous "")
foreach(v IN LISTS versions)
    if(NOT previous STREQUAL "" AND NOT v VERSION_LESS previous)
        message(FATAL_ERROR "CHANGELOG: ${v} does not come before ${previous}; newest first")
    endif()
    set(previous "${v}")
    if(NOT summary_${v})
        message(FATAL_ERROR "CHANGELOG ${v}: a summary precedes the categories")
    endif()
    list(FIND links "${v}" index)
    if(index EQUAL -1)
        message(FATAL_ERROR "CHANGELOG: missing comparison link '[${v}]: https://...' at the foot of the file")
    endif()
    if(NOT EXISTS "${ROOT}/docs/changelog/${v}.md")
        message(FATAL_ERROR "CHANGELOG: missing archive docs/changelog/${v}.md")
    endif()
endforeach()
list(FIND links "Unreleased" index)
if(index EQUAL -1)
    message(FATAL_ERROR "CHANGELOG: missing '[Unreleased]: https://...' comparison link")
endif()

# A recent version stays short.
file(READ "${ROOT}/docs/CHANGELOG.md" text)
foreach(v IN LISTS versions)
    if(v VERSION_LESS first_referenced_version)
        continue()
    endif()
    string(FIND "${text}" "## [${v}]" start)
    string(SUBSTRING "${text}" ${start} -1 rest)
    string(SUBSTRING "${rest}" 3 -1 rest)
    string(FIND "${rest}" "\n## " stop)
    if(stop EQUAL -1)
        string(FIND "${rest}" "\n[Unreleased]:" stop)
    endif()
    string(SUBSTRING "${rest}" 0 ${stop} section)
    string(REGEX MATCHALL "\n" newlines "${section}")
    list(LENGTH newlines count)
    if(count GREATER max_recent_lines)
        message(FATAL_ERROR "CHANGELOG ${v}: ${count} lines (limit ${max_recent_lines}); the detail belongs to its ADR or guide")
    endif()
endforeach()

message(STATUS "docs/CHANGELOG.md follows the documented format (${versions})")
