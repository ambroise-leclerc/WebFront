# The capture spec must leave real PNG files: the 8-byte signature, then an IHDR chunk with a non-empty size.
function(_check_png path)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing capture: ${path}")
    endif()
    file(READ "${path}" header LIMIT 24 HEX)
    if(NOT header MATCHES "^89504e470d0a1a0a0000000d49484452")
        message(FATAL_ERROR "Not a PNG: ${path}")
    endif()
    string(SUBSTRING "${header}" 32 16 size)
    if(size MATCHES "^00000000" OR size MATCHES "00000000$")
        message(FATAL_ERROR "Empty image: ${path}")
    endif()
endfunction()

_check_png("${DIRECTORY}/increment.png")
file(GLOB frames "${DIRECTORY}/animation/*.png")
list(LENGTH frames count)
if(count LESS 3)
    message(FATAL_ERROR "Expected at least 3 frames, found ${count}")
endif()
foreach(frame IN LISTS frames)
    _check_png("${frame}")
endforeach()
if(NOT EXISTS "${DIRECTORY}/animation/0001.png")
    message(FATAL_ERROR "Frames are not numbered from 0001")
endif()
