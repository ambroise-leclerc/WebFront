# Repeat the complete fixture graph, not individual stateful steps (wf init/install/restore).
cmake_minimum_required(VERSION 3.31)
if(NOT BUILD_DIR)
    message(FATAL_ERROR "BUILD_DIR is required")
endif()
if(NOT DEFINED REPEAT)
    set(REPEAT 1)
endif()
if(NOT REPEAT MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "REPEAT must be a positive integer")
endif()
# CTest runs in the build directory: a relative path would place a relative report path inside it, and miss the cleanup below.
cmake_path(ABSOLUTE_PATH BUILD_DIR NORMALIZE)
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(CTEST_EXECUTABLE ctest HINTS "${cmake_bin}" REQUIRED)
# A bounded default; override for measured CPU/RAM limits without editing the script.
if(NOT DEFINED PARALLEL)
    set(PARALLEL 4)
endif()
if(NOT PARALLEL MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "PARALLEL must be a positive integer")
endif()
set(options --test-dir "${BUILD_DIR}" --output-on-failure --no-tests=error --parallel "${PARALLEL}"
    --test-output-size-passed 2097152 --test-output-size-failed 2097152)
if(CONFIG)
    list(APPEND options -C "${CONFIG}")
endif()
# A reused build directory must only expose reports from this invocation.
file(GLOB previous_reports LIST_DIRECTORIES FALSE "${BUILD_DIR}/test-results-*.xml")
foreach(report IN LISTS previous_reports)
    get_filename_component(report_name "${report}" NAME)
    if(report_name MATCHES "^test-results-[1-9][0-9]*\\.xml$")
        file(REMOVE "${report}")
    endif()
endforeach()
file(GLOB previous_logs LIST_DIRECTORIES FALSE "${BUILD_DIR}/Testing/Temporary/LastTest-*.log")
foreach(log IN LISTS previous_logs)
    get_filename_component(log_name "${log}" NAME)
    if(log_name MATCHES "^LastTest-[1-9][0-9]*\\.log$")
        file(REMOVE "${log}")
    endif()
endforeach()
# One dedicated display for the entire fixture graph, reused by all compatible browser processes.
# Direct ctest invocations retain per-process xvfb-run isolation and never open windows on the user's display.
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux" AND NOT "$ENV{WEBFRONT_TEST_SHARED_DISPLAY}" STREQUAL "1")
    find_program(XVFB_RUN xvfb-run)
    if(XVFB_RUN)
        execute_process(COMMAND "${CMAKE_COMMAND}" -E env WEBFRONT_TEST_SHARED_DISPLAY=1
            "${XVFB_RUN}" -a "${CMAKE_COMMAND}" -DBUILD_DIR=${BUILD_DIR} -DCONFIG=${CONFIG}
            -DREPEAT=${REPEAT} -DPARALLEL=${PARALLEL} -P "${CMAKE_CURRENT_LIST_FILE}" RESULT_VARIABLE status)
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "CTest suite failed: ${status}")
        endif()
        return()
    endif()
endif()
foreach(pass RANGE 1 ${REPEAT})
    message(STATUS "CTest suite pass ${pass}/${REPEAT}")
    execute_process(COMMAND "${CTEST_EXECUTABLE}" ${options}
        --output-junit "${BUILD_DIR}/test-results-${pass}.xml" RESULT_VARIABLE result)
    if(EXISTS "${BUILD_DIR}/Testing/Temporary/LastTest.log")
        file(COPY_FILE "${BUILD_DIR}/Testing/Temporary/LastTest.log"
            "${BUILD_DIR}/Testing/Temporary/LastTest-${pass}.log")
    endif()
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "CTest suite pass ${pass}/${REPEAT} failed: ${result}")
    endif()
endforeach()
