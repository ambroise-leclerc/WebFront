# Repeat the complete fixture graph, not individual stateful steps (wf init/install/restore).
cmake_minimum_required(VERSION 3.31)
if(NOT BUILD_DIR)
    message(FATAL_ERROR "BUILD_DIR is required")
endif()
if(NOT DEFINED REPEAT)
    set(REPEAT 1)
endif()
if(NOT REPEAT MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "REPEAT must be a positive integer")
endif()
get_filename_component(cmake_bin "${CMAKE_COMMAND}" DIRECTORY)
find_program(CTEST_EXECUTABLE ctest HINTS "${cmake_bin}" REQUIRED)
set(options --test-dir "${BUILD_DIR}" --output-on-failure --no-tests=error --parallel 4)
if(CONFIG)
    list(APPEND options -C "${CONFIG}")
endif()
foreach(pass RANGE 1 ${REPEAT})
    message(STATUS "CTest suite pass ${pass}/${REPEAT}")
    execute_process(COMMAND "${CTEST_EXECUTABLE}" ${options}
        --output-junit "${BUILD_DIR}/test-results-${pass}.xml" RESULT_VARIABLE result)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "CTest suite pass ${pass}/${REPEAT} failed: ${result}")
    endif()
endforeach()
