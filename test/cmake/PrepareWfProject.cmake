# Gives the driver tests a fresh copy of the fixture project.
# Usage: cmake -DSOURCE=<fixture project> -DPROJECT=<directory to create> -P PrepareWfProject.cmake
cmake_minimum_required(VERSION 3.31)
if(NOT SOURCE OR NOT PROJECT)
    message(FATAL_ERROR "SOURCE and PROJECT are required")
endif()
if(NOT IS_DIRECTORY "${SOURCE}")
    message(FATAL_ERROR "SOURCE is not a fixture directory: ${SOURCE}")
endif()
if(LIFE_REACT AND (NOT EXISTS "${LIFE_REACT}" OR IS_DIRECTORY "${LIFE_REACT}"))
    message(FATAL_ERROR "LIFE_REACT does not name an existing file: ${LIFE_REACT}")
endif()
set(life_react_entry "pages/life-react.tsx")
if(EXISTS "${SOURCE}/webfront.project.json")
    file(READ "${SOURCE}/webfront.project.json" manifest)
    string(JSON entry ERROR_VARIABLE missing GET "${manifest}" entries life-react)
    if(NOT missing)
        set(life_react_entry "${entry}")
        if(NOT EXISTS "${SOURCE}/${entry}" AND NOT LIFE_REACT)
            message(FATAL_ERROR "The Life React entry '${entry}' is missing. Pass -DLIFE_REACT=<path to examples/life/react/main.tsx>")
        endif()
    endif()
endif()
# Validate inputs before replacing an existing prepared fixture.
file(REMOVE_RECURSE "${PROJECT}")
file(COPY "${SOURCE}/" DESTINATION "${PROJECT}")

if(LIFE_REACT)
    get_filename_component(entry_directory "${PROJECT}/${life_react_entry}" DIRECTORY)
    file(MAKE_DIRECTORY "${entry_directory}")
    file(COPY_FILE "${LIFE_REACT}" "${PROJECT}/${life_react_entry}")
endif()
