# A completed batch produces reports successfully even when an individual case failed.
# Keep --session's aggregate process status meaningful; CTest consumers decide their own outcomes.
if(NOT PROGRAM OR NOT FIXTURES OR NOT OUTPUT)
    message(FATAL_ERROR "PROGRAM, FIXTURES and OUTPUT are required")
endif()
foreach(part app scripts typescript jasmine terminal workspace)
    file(REMOVE "${OUTPUT}/results/${part}.json")
endforeach()
execute_process(COMMAND ${PREFIX} "${PROGRAM}" "${FIXTURES}" "${OUTPUT}" --session
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
message(STATUS "Developer session exit status ${status}\n${output}${errors}")
if(NOT status MATCHES "^[01]$" OR NOT output MATCHES "nativeWindows=1 parts=6")
    message(FATAL_ERROR "Developer session did not complete its reports (status ${status})")
endif()
set(expected 0)
foreach(part app scripts typescript jasmine terminal workspace)
    set(path "${OUTPUT}/results/${part}.json")
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Developer session wrote no report for ${part}")
    endif()
    file(READ "${path}" report)
    string(JSON code_type TYPE "${report}" exitCode)
    string(JSON code GET "${report}" exitCode)
    string(JSON output_type TYPE "${report}" output)
    if(NOT code_type STREQUAL "NUMBER" OR NOT code MATCHES "^[01]$" OR NOT output_type STREQUAL "STRING")
        message(FATAL_ERROR "Invalid developer report for ${part}: ${report}")
    endif()
    if(code EQUAL 1)
        set(expected 1)
    endif()
endforeach()
if(NOT status EQUAL expected)
    message(FATAL_ERROR "Developer session status ${status} disagrees with its reports (${expected})")
endif()
