# Transport timings are manual tools, never CTest cases, default build dependencies or CI jobs.
cmake_minimum_required(VERSION 3.31)
file(GLOB workflows "${ROOT}/.github/workflows/*.yml")
foreach(workflow IN LISTS workflows)
    file(READ "${workflow}" text)
    if(text MATCHES "transport[_-]benchmark|TransportBenchmark|performance-linux")
        message(FATAL_ERROR "Transport measurement has returned to CI: ${workflow}")
    endif()
endforeach()
foreach(frontend WebKitGTK WebView2 WKWebView)
    file(READ "${ROOT}/cmake/${frontend}Support.cmake" text)
    string(TOLOWER "${frontend}" target)
    if(NOT text MATCHES "add_executable\\(${target}_transport_benchmark EXCLUDE_FROM_ALL")
        message(FATAL_ERROR "${frontend} measurement must be an explicit manual build target")
    endif()
    if(NOT text MATCHES "add_test\\(NAME ${frontend}TransportContracts" OR NOT text MATCHES "WEBFRONT_TRANSPORT_CONTRACTS_ONLY")
        message(FATAL_ERROR "${frontend} must retain its short direct-channel contract test")
    endif()
    if(text MATCHES "add_test\\(NAME ${frontend}TransportBenchmark" OR text MATCHES "add_dependencies\\(webtest ${target}_transport_benchmark")
        message(FATAL_ERROR "${frontend} measurement must not be a CTest case or a webtest dependency")
    endif()
endforeach()
