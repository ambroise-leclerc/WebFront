cmake_minimum_required(VERSION 3.31)
if(NOT ROOT OR NOT WORK)
    message(FATAL_ERROR "ROOT and WORK are required")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/project")
file(WRITE "${WORK}/project/marker" "preserved until validation succeeds")
set(prepare "${ROOT}/test/cmake/PrepareWfProject.cmake")
set(source "${WORK}/suite")
file(MAKE_DIRECTORY "${source}")
file(COPY "${ROOT}/test/web/suite/webfront.project.json" DESTINATION "${source}")

function(prepare_project expected diagnostic)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DSOURCE=${source} -DPROJECT=${WORK}/project ${ARGN} -P "${prepare}"
        RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
    string(REGEX REPLACE "[ \t\r\n]+" " " diagnostic_text "${output}${error}")
    if(expected STREQUAL "success")
        if(NOT status EQUAL 0)
            message(FATAL_ERROR "Project preparation failed: ${output}${error}")
        endif()
    elseif(status EQUAL 0 OR NOT diagnostic_text MATCHES "${diagnostic}")
        message(FATAL_ERROR "Project preparation did not reject the missing input: ${output}${error}")
    endif()
endfunction()

prepare_project(failure "Pass -DLIFE_REACT")
prepare_project(failure "LIFE_REACT does not name an existing file" -DLIFE_REACT=${WORK}/missing.tsx)
if(NOT EXISTS "${WORK}/project/marker")
    message(FATAL_ERROR "Invalid inputs removed the existing fixture")
endif()
prepare_project(success "" -DLIFE_REACT=${ROOT}/examples/life/react/main.tsx)
file(SHA256 "${ROOT}/examples/life/react/main.tsx" expected)
file(SHA256 "${WORK}/project/pages/life-react.tsx" actual)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Prepared Life entry differs from the maintained example")
endif()
# A generic wf fixture has no Life entry and must still work without LIFE_REACT.
set(source "${ROOT}/test/fixtures/wf-project")
prepare_project(success "")

execute_process(COMMAND "${CMAKE_COMMAND}" -DBUILD=${WORK}/missing-build -DOUTPUT=${WORK}/pages
    -P "${ROOT}/test/cmake/PrepareReactExample.cmake" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
string(REGEX REPLACE "[ \t\r\n]+" " " diagnostic_text "${output}${error}")
if(status EQUAL 0 OR NOT diagnostic_text MATCHES "run wf build first")
    message(FATAL_ERROR "Missing compiled assets did not fail explicitly: ${output}${error}")
endif()
file(MAKE_DIRECTORY "${WORK}/build/assets")
file(WRITE "${WORK}/build/app.js" "export const compiled = true;\n")
file(WRITE "${WORK}/build/assets/test.txt" "asset")
execute_process(COMMAND "${CMAKE_COMMAND}" -DBUILD=${WORK}/build -DOUTPUT=${WORK}/pages
    -P "${ROOT}/test/cmake/PrepareReactExample.cmake" RESULT_VARIABLE status)
if(NOT status EQUAL 0 OR NOT EXISTS "${WORK}/pages/app.js" OR NOT EXISTS "${WORK}/pages/assets/test.txt")
    message(FATAL_ERROR "Compiled React assets were not staged in the page tree")
endif()
