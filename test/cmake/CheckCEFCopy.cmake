# The Linux CEF file copy of cmake/CEFSupport.cmake, with stand-in CEF files: one copy per destination, which is the
# target's own output directory; nothing copied again by a build with nothing to copy; explicit errors for the output
# directories it cannot honour. No compiler, SDK or network.
#   cmake -DROOT=<checkout> [-DTEST_GENERATOR=<generator>] -P test/cmake/CheckCEFCopy.cmake
cmake_minimum_required(VERSION 3.31)
if(NOT ROOT)
    message(FATAL_ERROR "ROOT must be supplied")
endif()
set(generator_args "")
if(TEST_GENERATOR)
    list(APPEND generator_args -G "${TEST_GENERATOR}")
endif()
set(work "${CMAKE_CURRENT_BINARY_DIR}/cef-copy")
set(source "${work}/source")
file(REMOVE_RECURSE "${work}")
file(WRITE "${source}/libcef.so" "library 1")
file(WRITE "${source}/locales/en-US.pak" "locale")

function(configure state out_result out_log)
    execute_process(
        COMMAND "${CMAKE_COMMAND}" -S "${ROOT}/test/cmake/cef-copy" -B "${work}/${state}" ${generator_args}
            -DROOT=${ROOT} -DSOURCE_DIR=${source} -DSTATE=${state} -DCMAKE_BUILD_TYPE=Release
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(${out_result} ${result} PARENT_SCOPE)
    set(${out_log} "${output}${error}" PARENT_SCOPE)
endfunction()

function(build out_log)
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${work}/plan" --config Release
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Build of the copy fixture failed: ${output}${error}")
    endif()
    set(${out_log} "${output}${error}" PARENT_SCOPE)
endfunction()

function(expect_file path content)
    if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing copied file ${path}")
    endif()
    file(READ "${path}" actual)
    if(NOT actual STREQUAL content)
        message(FATAL_ERROR "${path} holds '${actual}', expected '${content}'")
    endif()
endfunction()

configure(plan result log)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Copy destinations: ${log}")
endif()
build(first)
string(REGEX MATCHALL "Copying CEF libcef.so to [^\n]*" copies "${first}")
list(LENGTH copies count)
if(NOT count EQUAL 2)
    message(FATAL_ERROR "Each of the two destinations must be copied once, got ${count}: ${first}")
endif()
foreach(destination "${work}/plan" "${work}/plan/bin")
    if(NOT EXISTS "${destination}/libcef.so" AND EXISTS "${destination}/Release/libcef.so")
        set(destination "${destination}/Release")
    endif()
    expect_file("${destination}/libcef.so" "library 1")
    expect_file("${destination}/locales/en-US.pak" "locale")
endforeach()
build(second)
if(second MATCHES "Copying CEF")
    message(FATAL_ERROR "A build with nothing to copy must copy nothing: ${second}")
endif()
file(WRITE "${source}/libcef.so" "library 2")
build(third)
if(NOT third MATCHES "Copying CEF libcef.so" OR third MATCHES "Copying CEF locales")
    message(FATAL_ERROR "Only the changed file must be copied again: ${third}")
endif()
foreach(destination "${work}/plan" "${work}/plan/bin")
    if(NOT EXISTS "${destination}/libcef.so" AND EXISTS "${destination}/Release/libcef.so")
        set(destination "${destination}/Release")
    endif()
    expect_file("${destination}/libcef.so" "library 2")
endforeach()

configure(per-config result log)
# CMake wraps long messages: any whitespace may separate the words.
if(result EQUAL 0 OR NOT log MATCHES "sets[ \t\r\n]+RUNTIME_OUTPUT_DIRECTORY_RELEASE")
    message(FATAL_ERROR "A per-configuration output directory must be refused: ${log}")
endif()
configure(late result log)
if(result EQUAL 0 OR NOT log MATCHES "now[ \t\r\n]+builds[ \t\r\n]+into")
    message(FATAL_ERROR "An output directory set after the copy was planned must be refused: ${log}")
endif()
message(STATUS "CEF copy destinations, incremental copies and refusals checked")
