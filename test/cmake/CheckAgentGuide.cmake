# What an agent meets first must state the development model and how it runs wf itself (#561): the README before its
# tutorial, the guide written into consuming projects and starters, the configuration notice, and the public helper
# webfront_write_agent_guide(), which never replaces a file.
# Usage: cmake -DROOT=<checkout> -DWORK=<scratch directory> -P CheckAgentGuide.cmake
cmake_minimum_required(VERSION 3.31)
if(NOT ROOT OR NOT WORK)
    message(FATAL_ERROR "ROOT and WORK are required")
endif()
set(failures "")
function(_require haystack needle description)
    string(FIND "${haystack}" "${needle}" position)
    if(position EQUAL -1)
        list(APPEND failures "${description}: missing '${needle}'")
        set(failures "${failures}" PARENT_SCOPE)
    endif()
endfunction()
function(_read var path)
    file(READ "${ROOT}/${path}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    set(${var} "${content}" PARENT_SCOPE)
endfunction()

_read(readme README.md)
_read(guide js/developer/starters/agent-guide.md)
_read(page docs/DEVELOPING_WITH_AGENTS.md)

# The README says it before the first tutorial, not after the walkthrough.
string(FIND "${readme}" "## Developing with an agent" agents_at)
string(FIND "${readme}" "## From C++ to a reactive UI" tutorial_at)
if(agents_at EQUAL -1 OR tutorial_at EQUAL -1 OR agents_at GREATER tutorial_at)
    list(APPEND failures "README.md must have '## Developing with an agent' before '## From C++ to a reactive UI'")
else()
    string(SUBSTRING "${readme}" ${agents_at} -1 rest)
    string(FIND "${rest}" "\n## From C++ to a reactive UI" length)
    string(SUBSTRING "${rest}" 0 ${length} first_screen)
    foreach(needle "`ui/`" "`wf dev`" "documentRoot" "webfront-agent" "-DWEBFRONT_BUILD_AUTOMATION=ON" "enableAutomation"
            "--print-mcp-config" "\"mcpServers\"" "docs/DEVELOPING_WITH_AGENTS.md" "webfront_write_agent_guide()")
        _require("${first_screen}" "${needle}" "README first screen for agents")
    endforeach()
endif()

# The same facts in the file an agent reads in a consuming project, and in the page the tools point to.
foreach(text guide page)
    foreach(needle "ui/" "wf dev" "documentRoot" "app.bootstrap(\"developer\")" "-DWEBFRONT_BUILD_AUTOMATION=ON" "enableAutomation"
            "webfront-agent --list" "--operation create --starter app" "--operation preview --entry ui/main.ts"
            "--print-mcp-config" "webfront.start" "not\nthe name of your project")
        string(REPLACE "\n" " " flat "${${text}}")
        string(REPLACE "\n" " " flat_needle "${needle}")
        _require("${flat}" "${flat_needle}" "${text}")
    endforeach()
endforeach()

# The helper writes the guide once and leaves any existing file alone.
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/fresh" "${WORK}/owned")
file(WRITE "${WORK}/owned/AGENTS.md" "the project's own instructions\n")
# Included by a scope that ends, called from another one, as add_subdirectory(WebFront) and a call in the parent do: the
# functions outlive the variables of the including scope.
file(WRITE "${WORK}/run.cmake" "
function(load_webfront)
    include(\"${ROOT}/cmake/WebFrontAgentGuide.cmake\")
endfunction()
load_webfront()
webfront_write_agent_guide(DIRECTORY \"${WORK}/fresh\")
webfront_write_agent_guide(DIRECTORY \"${WORK}/fresh\")
webfront_write_agent_guide(DIRECTORY \"${WORK}/fresh\" NAME CLAUDE.md)
webfront_write_agent_guide(DIRECTORY \"${WORK}/owned\")
webfront_announce_agent_support()
webfront_announce_agent_support()
")
execute_process(COMMAND "${CMAKE_COMMAND}" -P "${WORK}/run.cmake" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE output)
if(NOT status EQUAL 0)
    list(APPEND failures "webfront_write_agent_guide failed: ${output}")
endif()
foreach(name AGENTS.md CLAUDE.md)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E compare_files "${ROOT}/js/developer/starters/agent-guide.md" "${WORK}/fresh/${name}"
        RESULT_VARIABLE different)
    if(different)
        list(APPEND failures "${name} is not the agent guide")
    endif()
endforeach()
file(READ "${WORK}/owned/AGENTS.md" owned)
if(NOT owned STREQUAL "the project's own instructions\n")
    list(APPEND failures "An existing AGENTS.md was modified")
endif()
_require("${output}" "owned/AGENTS.md exists and is left unchanged; the agent guide is " "existing file notice")
_require("${output}" "TypeScript/TSX interface in ui/, developed with `wf dev`" "configuration notice: model")
_require("${output}" "is not built: configure with -DWEBFRONT_BUILD_AUTOMATION=ON" "configuration notice: launcher option")
_require("${output}" "docs/DEVELOPING_WITH_AGENTS.md" "configuration notice: guide")
string(REGEX MATCHALL "WebFront for agents:" notices "${output}")
list(LENGTH notices count)
if(NOT count EQUAL 1)
    list(APPEND failures "The configuration notice must be printed once, not ${count} times")
endif()
foreach(bad "NAME ../AGENTS.md" "NAME sub/AGENTS.md" "DIRECTORY \"${WORK}/missing\"" "EXTRA")
    file(WRITE "${WORK}/bad.cmake" "include(\"${ROOT}/cmake/WebFrontAgentGuide.cmake\")\nwebfront_write_agent_guide(${bad})\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${WORK}/bad.cmake" RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET
        WORKING_DIRECTORY "${WORK}/fresh")
    if(status EQUAL 0)
        list(APPEND failures "webfront_write_agent_guide(${bad}) must be refused")
    endif()
endforeach()
if(EXISTS "${WORK}/AGENTS.md")
    list(APPEND failures "A refused call wrote outside its directory")
endif()

if(failures)
    list(JOIN failures "\n  " text)
    message(FATAL_ERROR "Agent guidance drifted:\n  ${text}")
endif()
message(STATUS "Agent guidance is announced in the README, the guide, the helper and the configuration notice")
