# check-release-paths.sh accepts a diff inside the closed list of paths and refuses any other path, tracked or not
# (acceptance criterion 4 of ADR-021). SCRIPT is the script, WORK a scratch directory, BASH the shell.
cmake_minimum_required(VERSION 3.31)
if(NOT SCRIPT OR NOT WORK OR NOT BASH)
    message(FATAL_ERROR "SCRIPT, WORK and BASH are required")
endif()
find_package(Git REQUIRED QUIET)
string(RANDOM LENGTH 12 ALPHABET 0123456789abcdef suffix)
set(repo "${WORK}/repo-${suffix}")
file(MAKE_DIRECTORY "${repo}/allowed" "${repo}/other")
file(WRITE "${repo}/allowed/a.txt" "1\n")
file(WRITE "${repo}/other/b.txt" "1\n")
function(git)
    execute_process(COMMAND "${GIT_EXECUTABLE}" -c user.name=Test -c user.email=test@example.invalid -c commit.gpgsign=false ${ARGN}
        WORKING_DIRECTORY "${repo}" COMMAND_ERROR_IS_FATAL ANY OUTPUT_QUIET ERROR_QUIET)
endfunction()
git(init)
git(add .)
git(commit -m fixture)

function(check description expected)
    execute_process(COMMAND "${BASH}" "${SCRIPT}" allowed/a.txt allowed/new.txt
        WORKING_DIRECTORY "${repo}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected STREQUAL "accept" AND NOT result EQUAL 0)
        message(FATAL_ERROR "${description}: refused: ${output}${error}")
    elseif(expected STREQUAL "refuse" AND (result EQUAL 0 OR NOT "${output}${error}" MATCHES "closed list"))
        message(FATAL_ERROR "${description}: accepted or no diagnostic: ${output}${error}")
    endif()
endfunction()

check("no change" accept)
file(WRITE "${repo}/allowed/a.txt" "2\n")
file(WRITE "${repo}/allowed/new.txt" "new\n")
check("changes inside the list" accept)
file(WRITE "${repo}/other/b.txt" "2\n")
check("a tracked path outside the list" refuse)
git(checkout -- other/b.txt)
file(WRITE "${repo}/other/untracked.txt" "x\n")
check("an untracked path outside the list" refuse)
file(REMOVE_RECURSE "${repo}")
