# Deliberately bounded readers for the workflow syntax used by the local CI lanes.
# They never evaluate shell code or GitHub expressions. New matrix shapes must be
# taught to the checker rather than silently reducing the number of checked lanes.
function(lane_matrix block key value out_entry out_block)
    string(REPLACE ";" "\\;" lines "${block}")
    string(REPLACE "\n" ";" lines "${lines}")
    set(in_matrix FALSE)
    set(selected FALSE)
    set(entry "")
    set(matrix_text "")
    foreach(line IN LISTS lines)
        if(line STREQUAL "      matrix:")
            set(in_matrix TRUE)
            string(APPEND matrix_text "${line}\n")
            continue()
        endif()
        if(NOT in_matrix)
            continue()
        endif()
        if(line MATCHES "^ *[^ #]" AND NOT line MATCHES "^        ")
            set(in_matrix FALSE)
            continue()
        endif()
        string(APPEND matrix_text "${line}\n")
        if(line MATCHES "^        ([A-Za-z_][A-Za-z0-9_-]*): *(.*)$")
            set(field "${CMAKE_MATCH_1}")
            set(contents "${CMAKE_MATCH_2}")
            if(NOT field STREQUAL key AND NOT field STREQUAL "include")
                report("unsupported matrix field '${field}': declare and support every matrix axis")
            elseif(field STREQUAL key AND NOT contents MATCHES "^\\[[^]]+\\]$")
                report("unsupported matrix axis '${key}': expected an inline list")
            elseif(field STREQUAL "include" AND NOT contents STREQUAL "")
                report("unsupported matrix include: expected a block list")
            endif()
        elseif(line MATCHES "^ *- ([A-Za-z_][A-Za-z0-9_-]*): *([A-Za-z0-9_-]+)$")
            if(NOT CMAKE_MATCH_1 STREQUAL key)
                report("unsupported matrix include key '${CMAKE_MATCH_1}', expected '${key}'")
            endif()
            if(CMAKE_MATCH_2 STREQUAL value)
                set(selected TRUE)
            else()
                set(selected FALSE)
            endif()
        elseif(NOT line MATCHES "^ *(#.*)?$" AND NOT line MATCHES "^ +[A-Za-z_][A-Za-z0-9_-]*: .+$")
            report("unsupported matrix syntax: ${line}")
        endif()
        if(selected)
            string(APPEND entry "${line}\n")
        endif()
    endforeach()
    if(matrix_text STREQUAL "")
        report("unsupported or missing matrix block")
    endif()
    string(REPLACE "${matrix_text}" "" resolved "${block}")

    # Resolve only the selected row and the simple string-valued conditional used
    # by the sanitizer configure command. Other expressions fail in command_tokens.
    set(conditional "\\$\\{\\{ *matrix\\.([A-Za-z_-]+) == '([^']*)' && '([^']*)' \\|\\| '([^']*)' *\\}\\}")
    while(resolved MATCHES "${conditional}")
        set(expression "${CMAKE_MATCH_0}")
        if(NOT CMAKE_MATCH_1 STREQUAL key)
            report("unsupported matrix condition: ${expression}")
            break()
        endif()
        if(CMAKE_MATCH_2 STREQUAL value)
            set(replacement "${CMAKE_MATCH_3}")
        else()
            set(replacement "${CMAKE_MATCH_4}")
        endif()
        string(REPLACE "${expression}" "${replacement}" resolved "${resolved}")
    endwhile()
    string(REGEX MATCHALL "\\$\\{\\{ *matrix\\.[A-Za-z_-]+ *\\}\\}" expressions "${resolved}")
    foreach(expression IN LISTS expressions)
        string(REGEX MATCH "matrix\\.([A-Za-z_-]+)" unused "${expression}")
        set(field "${CMAKE_MATCH_1}")
        if(field STREQUAL key)
            set(replacement "${value}")
        elseif(entry MATCHES "\n *${field}: ([^\n]*)")
            set(replacement "${CMAKE_MATCH_1}")
        else()
            continue()
        endif()
        string(REPLACE "${expression}" "${replacement}" resolved "${resolved}")
    endforeach()
    set(${out_entry} "${entry}" PARENT_SCOPE)
    set(${out_block} "${resolved}" PARENT_SCOPE)
endfunction()

function(json_quote value out)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${out} "\"${value}\"" PARENT_SCOPE)
endfunction()

# Collect run scalars, folding >- and preserving literal | scripts. YAML keys and
# comments cannot masquerade as executed command arguments.
function(workflow_scripts block out)
    string(REPLACE ";" "\\;" lines "${block}\nEND")
    string(REPLACE "\n" ";" lines "${lines}")
    set(scripts "[]")
    set(active FALSE)
    foreach(line IN LISTS lines)
        if(active)
            string(REGEX MATCH "^ *" indent "${line}")
            string(LENGTH "${indent}" width)
            if(line MATCHES "^ *$" OR width GREATER run_indent)
                string(STRIP "${line}" content)
                string(APPEND script "${content}${separator}")
                continue()
            endif()
            json_quote("${script}" quoted)
            string(JSON count LENGTH "${scripts}")
            string(JSON scripts SET "${scripts}" ${count} "${quoted}")
            set(active FALSE)
        endif()
        if(line MATCHES "^( *)run: *(.*)$")
            string(LENGTH "${CMAKE_MATCH_1}" run_indent)
            set(script "${CMAKE_MATCH_2}")
            if(script MATCHES "^[>|][-+]?$")
                if(script MATCHES "^>")
                    set(separator " ")
                else()
                    set(separator "\n")
                endif()
                set(script "")
                set(active TRUE)
            else()
                json_quote("${script}" quoted)
                string(JSON count LENGTH "${scripts}")
                string(JSON scripts SET "${scripts}" ${count} "${quoted}")
            endif()
        endif()
    endforeach()
    set(${out} "${scripts}" PARENT_SCOPE)
endfunction()

function(command_tokens command lane out)
    # Workspace paths vary locally. Compact the remaining expressions to keep
    # them single tokens; their exact contents are still compared to lanes.json.
    string(REGEX REPLACE "\\$\\{\\{ *github\\.workspace *\\}\\}" "@workspace@" command "${command}")
    string(REGEX MATCHALL "\\$\\{\\{[^}]*\\}\\}" expressions "${command}")
    set(index 0)
    foreach(expression IN LISTS expressions)
        if(expression MATCHES "matrix\\.")
            report("lane ${lane}: unsupported command expression ${expression}")
        endif()
        string(REPLACE " " "" expression_${index} "${expression}")
        string(REPLACE "${expression}" "@expression${index}@" command "${command}")
        math(EXPR index "${index} + 1")
    endforeach()
    separate_arguments(tokens UNIX_COMMAND "${command}")
    while(index GREATER 0)
        math(EXPR index "${index} - 1")
        string(REPLACE "@expression${index}@" "${expression_${index}}" tokens "${tokens}")
    endwhile()
    set(${out} "${tokens}" PARENT_SCOPE)
endfunction()

function(compare_arguments lane what expected actual)
    # Argument order is irrelevant for these option lists, but duplicates and
    # values are significant (including the operand of a CTest filter).
    list(SORT expected)
    list(SORT actual)
    if(NOT "${expected}" STREQUAL "${actual}")
        report("lane ${lane}: ${what} differ: expected [${expected}], workflow [${actual}]")
    endif()
endfunction()

# Keep each CTest switch attached to its operand before comparing option sets.
function(option_pairs tokens out)
    set(pairs "")
    while(tokens)
        list(POP_FRONT tokens token)
        if(token MATCHES "^-" AND NOT token MATCHES "=" AND tokens)
            list(GET tokens 0 next)
            if(NOT next MATCHES "^-")
                list(POP_FRONT tokens next)
                string(APPEND token "=${next}")
            endif()
        endif()
        list(APPEND pairs "${token}")
    endwhile()
    set(${out} "${pairs}" PARENT_SCOPE)
endfunction()

function(check_lane_commands block lane)
    string(JSON id GET "${lane}" id)
    string(JSON build_type GET "${lane}" build_type)
    set(expected_options "-DCMAKE_BUILD_TYPE=${build_type}")
    foreach(field options common_options workflow_options)
        string(JSON array ERROR_VARIABLE err GET "${lane}" ${field})
        if(NOT err)
            json_strings("${array}" items)
            list(APPEND expected_options ${items})
        endif()
    endforeach()
    string(JSON toolchain ERROR_VARIABLE err GET "${lane}" toolchain_file)
    if(NOT err)
        list(APPEND expected_options "-DCMAKE_TOOLCHAIN_FILE=@workspace@/${toolchain}")
    endif()
    string(JSON variants ERROR_VARIABLE err GET "${lane}" configure_variants)
    if(err)
        set(variants "[[]]")
    endif()
    string(JSON configure_count LENGTH "${variants}")
    string(JSON array GET "${lane}" targets)
    json_strings("${array}" expected_targets)
    string(JSON array GET "${lane}" ctest args)
    json_strings("${array}" expected_ctest)
    if(expected_ctest)
        set(ctest_count ${configure_count})
    else()
        set(ctest_count 0)
    endif()
    foreach(field labels exclude_labels workflow_args)
        string(JSON array ERROR_VARIABLE err GET "${lane}" ctest ${field})
        if(NOT err)
            json_strings("${array}" items)
            foreach(item IN LISTS items)
                if(field STREQUAL "labels")
                    list(APPEND expected_ctest "-L" "${item}")
                elseif(field STREQUAL "exclude_labels")
                    list(APPEND expected_ctest "-LE" "${item}")
                else()
                    list(APPEND expected_ctest "${item}")
                endif()
            endforeach()
        endif()
    endforeach()
    option_pairs("${expected_ctest}" expected_ctest)
    set(configures 0)
    set(builds 0)
    set(ctests 0)
    set(catch_calls 0)
    set(configure_dirs "")
    set(build_dirs "")
    set(ctest_dirs "")
    workflow_scripts("${block}" scripts)
    string(JSON count LENGTH "${scripts}")
    if(count EQUAL 0)
        report("lane ${id}: no run commands")
        return()
    endif()
    math(EXPR last "${count} - 1")
    foreach(i RANGE ${last})
        string(JSON script GET "${scripts}" ${i})
        string(REPLACE "\\\n" " " script "${script}")
        string(REPLACE ";" "\\;" lines "${script}")
        string(REPLACE "\n" ";" lines "${lines}")
        foreach(line IN LISTS lines)
            string(STRIP "${line}" line)
            if(NOT line MATCHES "^(cmake |ctest |\\./[^ ]+/test/unit/tests )")
                continue()
            endif()
            command_tokens("${line}" "${id}" tokens)
            list(POP_FRONT tokens program)
            if(program STREQUAL "cmake" AND NOT line MATCHES "^cmake --")
                set(actual_options "")
                set(was_build_dir FALSE)
                foreach(token IN LISTS tokens)
                    if(was_build_dir)
                        list(APPEND configure_dirs "${token}")
                    endif()
                    if(token STREQUAL "-B")
                        set(was_build_dir TRUE)
                    else()
                        set(was_build_dir FALSE)
                    endif()
                    if(token MATCHES "^-D")
                        list(APPEND actual_options "${token}")
                    endif()
                endforeach()
                set(expected "${expected_options}")
                if(configures LESS configure_count)
                    string(JSON array GET "${variants}" ${configures})
                    json_strings("${array}" items)
                    list(APPEND expected ${items})
                endif()
                compare_arguments("${id}" "configure options" "${expected}" "${actual_options}")
                math(EXPR configures "${configures} + 1")
            elseif(program STREQUAL "cmake" AND line MATCHES "^cmake --build ")
                list(GET tokens 1 directory)
                list(APPEND build_dirs "${directory}")
                set(targets "")
                set(in_targets FALSE)
                foreach(token IN LISTS tokens)
                    if(token STREQUAL "--target")
                        set(in_targets TRUE)
                    elseif(token MATCHES "^--target=(.+)$")
                        list(APPEND targets "${CMAKE_MATCH_1}")
                        set(in_targets TRUE)
                    elseif(token MATCHES "^-")
                        set(in_targets FALSE)
                    elseif(in_targets)
                        list(APPEND targets "${token}")
                    endif()
                endforeach()
                compare_arguments("${id}" "build targets" "${expected_targets}" "${targets}")
                math(EXPR builds "${builds} + 1")
            elseif(program STREQUAL "ctest")
                set(actual "")
                while(tokens)
                    list(POP_FRONT tokens token)
                    if(token STREQUAL "--test-dir" OR token STREQUAL "-C")
                        if(NOT tokens)
                            report("lane ${id}: CTest ${token} has no operand")
                            break()
                        endif()
                        list(POP_FRONT tokens operand)
                        if(token STREQUAL "--test-dir")
                            list(APPEND ctest_dirs "${operand}")
                        endif()
                        if(token STREQUAL "-C" AND NOT operand STREQUAL build_type)
                            report("lane ${id}: CTest configuration ${operand}, expected ${build_type}")
                        endif()
                    else()
                        list(APPEND actual "${token}")
                    endif()
                endwhile()
                option_pairs("${actual}" actual)
                compare_arguments("${id}" "CTest arguments" "${expected_ctest}" "${actual}")
                math(EXPR ctests "${ctests} + 1")
            elseif(program MATCHES "/test/unit/tests$")
                string(JSON array ERROR_VARIABLE err GET "${lane}" catch2_direct ${catch_calls})
                if(err)
                    report("lane ${id}: undeclared Catch2 command")
                else()
                    json_strings("${array}" expected)
                    if(script MATCHES "for iteration in ([0-9 ]+); do")
                        separate_arguments(iterations UNIX_COMMAND "${CMAKE_MATCH_1}")
                        list(LENGTH iterations repeats)
                        list(APPEND tokens "x${repeats}")
                    endif()
                    option_pairs("${expected}" expected)
                    option_pairs("${tokens}" actual)
                    compare_arguments("${id}" "Catch2 arguments" "${expected}" "${actual}")
                endif()
                math(EXPR catch_calls "${catch_calls} + 1")
            endif()
        endforeach()
    endforeach()
    compare_arguments("${id}" "configured and built directories" "${configure_dirs}" "${build_dirs}")
    if(ctest_count GREATER 0)
        compare_arguments("${id}" "configured and tested directories" "${configure_dirs}" "${ctest_dirs}")
    endif()
    string(JSON catch_count ERROR_VARIABLE err LENGTH "${lane}" catch2_direct)
    if(err)
        set(catch_count 0)
    endif()
    foreach(pair "configures|${configure_count}" "builds|${configure_count}" "ctests|${ctest_count}" "catch_calls|${catch_count}")
        string(REPLACE "|" ";" pair "${pair}")
        list(GET pair 0 field)
        list(GET pair 1 expected)
        if(NOT ${field} EQUAL expected)
            report("lane ${id}: ${field} count ${${field}}, expected ${expected}")
        endif()
    endforeach()
endfunction()
