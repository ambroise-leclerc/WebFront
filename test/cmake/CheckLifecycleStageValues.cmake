file(READ "${SOURCE_DIR}/test/web/FrontendLifecycle.cpp" cpp)
foreach(page view-association.html content-policy.html policy-escaped.html lifecycle-stage-probe.html)
    file(READ "${SOURCE_DIR}/test/web/${page}" html)
    string(REGEX MATCH "const stage = \\{[^}]+\\}" declaration "${html}")
    if(NOT declaration)
        message(FATAL_ERROR "Missing stage declaration in ${page}")
    endif()
    string(REGEX MATCHALL "[A-Za-z][A-Za-z0-9]*: *[0-9]+" entries "${declaration}")
    foreach(entry IN LISTS entries)
        string(REGEX REPLACE "^([A-Za-z][A-Za-z0-9]*): *([0-9]+)$" "\\1" name "${entry}")
        string(REGEX REPLACE "^([A-Za-z][A-Za-z0-9]*): *([0-9]+)$" "\\2" value "${entry}")
        if(NOT cpp MATCHES "(^|[\n\r])[ \t]*${name}[ \t]*=[ \t]*${value}[ \t]*,")
            message(FATAL_ERROR "${page}: ${entry} does not match LifecycleStage in FrontendLifecycle.cpp")
        endif()
    endforeach()
    if(NOT entries)
        message(FATAL_ERROR "No stage values found in ${page}")
    endif()
    string(REGEX MATCHALL "stage\\.[A-Za-z][A-Za-z0-9]*" references "${html}")
    foreach(reference IN LISTS references)
        string(REGEX REPLACE "^stage\\." "" name "${reference}")
        if(NOT declaration MATCHES "(^|[{,])[ \t]*${name}[ \t]*:")
            message(FATAL_ERROR "${page}: ${reference} has no declared value")
        endif()
    endforeach()
endforeach()
