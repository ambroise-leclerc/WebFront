# Verify the archive prepared by wf contains the package's actual maintained sources.
cmake_minimum_required(VERSION 3.31)
file(REMOVE_RECURSE "${WORK}")
file(READ "${ROOT}/js/react/package.json" manifest)
string(JSON package_version GET "${manifest}" version)
set(archive "${PROJECT}/build-react-package/webfront-react-${package_version}.tgz")
include("${ROOT}/cmake/WebFrontBootstrap.cmake")
webfront_file_sri("${archive}" actual_integrity)
file(READ "${PROJECT}/build-react-package/integrity.txt" expected_integrity)
string(STRIP "${expected_integrity}" expected_integrity)
if(NOT actual_integrity STREQUAL expected_integrity)
    message(FATAL_ERROR "React package integrity.txt differs from the archive SHA-512")
endif()
file(SHA512 "${archive}" archive_hash)
file(SHA512 "${PROJECT}/build-registry/webfront-react-${package_version}.tgz" registry_hash)
if(NOT archive_hash STREQUAL registry_hash)
    message(FATAL_ERROR "React registry tarball differs from wf run react-package")
endif()
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${WORK}")
file(GLOB_RECURSE actual_files LIST_DIRECTORIES false RELATIVE "${WORK}" "${WORK}/*")
set(expected_files package/package.json package/index.mjs package/index.d.ts package/README.md package/LICENSE)
list(SORT actual_files)
list(SORT expected_files)
if(NOT actual_files STREQUAL expected_files)
    message(FATAL_ERROR "React package file list differs: ${actual_files}")
endif()
foreach(name package.json index.mjs index.d.ts README.md LICENSE)
    file(SHA256 "${ROOT}/js/react/${name}" expected)
    file(SHA256 "${WORK}/package/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "React package differs from sources: ${name}")
    endif()
endforeach()
file(SHA256 "${ROOT}/LICENSE" expected)
file(SHA256 "${WORK}/package/LICENSE" actual)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "React package license differs")
endif()
