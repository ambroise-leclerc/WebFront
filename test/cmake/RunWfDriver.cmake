# Runs webfront-wf and checks its exit status and output.
# Usage: cmake -DDRIVER=<exe> -DPROJECT=<dir> -DEXPECT_STATUS=<n> [-DENVIRONMENT=<archive> -DINTEGRITY=<sri>]
#   [-DREGISTRY=<dir>] [-DTIMEOUT=<s>] [-DEXPECT_OUTPUT=<regex>] [-DEXPECT_REPORT=<regex>] [-DFORGE=<protocol>:<api>
#   -DWORK=<dir>] [-DRENAME_ENTRY=<module name>] [-DFRESH_PROJECT=<dir>: an empty project instead of PROJECT] -DCOMMAND=<word>|<word>... -P RunWfDriver.cmake
# SLEEP_ENVIRONMENT uses a tiny compatible archive whose command records its start before sleeping; EXPECT_FILE
# requires that record after the watchdog exits. Real packaged-script execution is covered by the other driver cases.
# PROVISION is the provision.json of ENVIRONMENT, from which an INTEGRITY left empty is read when the test runs.
# PROFILE is a directory for the browser's own persistent state (WebKitGTK profile), emptied first: a browser reuses the
# modules it loaded by URL, and the first page that loads another environment through the same profile fails with
# "Importing a module script failed". Every case then starts from nothing.
# FORGE replaces ENVIRONMENT with an archive whose environment.json declares the given protocol and API versions.
if(PROFILE)
    file(REMOVE_RECURSE "${PROFILE}")
    set(ENV{XDG_DATA_HOME} "${PROFILE}/data")
    set(ENV{XDG_CACHE_HOME} "${PROFILE}/cache")
endif()
if(FORGE)
    include("${ROOT}/cmake/WebFrontBootstrap.cmake")
    string(REPLACE ":" ";" versions "${FORGE}")
    list(GET versions 0 protocol)
    list(GET versions 1 api)
    file(REMOVE_RECURSE "${WORK}/forged")
    file(MAKE_DIRECTORY "${WORK}/forged/package")
    file(WRITE "${WORK}/forged/package/environment.json" "{\"protocol\": ${protocol}, \"api\": ${api}, \"entry\": \"runtime.mjs\"}\n")
    file(WRITE "${WORK}/forged/package/runtime.mjs" "export function mount() {}\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${WORK}/forged.tgz" --format=gnutar package
        WORKING_DIRECTORY "${WORK}/forged" RESULT_VARIABLE tarred)
    if(NOT tarred EQUAL 0)
        message(FATAL_ERROR "Cannot build the forged environment")
    endif()
    set(ENVIRONMENT "${WORK}/forged.tgz")
    webfront_file_sri("${ENVIRONMENT}" INTEGRITY)
endif()

if(PROVISION AND ENVIRONMENT AND NOT INTEGRITY AND NOT FORGE)
    file(READ "${PROVISION}" provision)
    string(JSON INTEGRITY GET "${provision}" integrity)
endif()

if(SLEEP_ENVIRONMENT)
    # The watchdog must interrupt an active command, independently of WASM compiler startup cost.
    include("${ROOT}/cmake/WebFrontBootstrap.cmake")
    file(REMOVE_RECURSE "${WORK}/sleep-environment")
    file(MAKE_DIRECTORY "${WORK}/sleep-environment/package")
    file(COPY "${ROOT}/test/fixtures/wf-sleep-environment/" DESTINATION "${WORK}/sleep-environment/package")
    set(ENVIRONMENT "${WORK}/sleep-environment.tgz")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${ENVIRONMENT}" --format=gnutar package
        WORKING_DIRECTORY "${WORK}/sleep-environment" RESULT_VARIABLE packed)
    if(NOT packed EQUAL 0)
        message(FATAL_ERROR "Cannot pack the watchdog environment")
    endif()
    webfront_file_sri("${ENVIRONMENT}" INTEGRITY)
endif()

if(FRESH_PROJECT)
    set(PROJECT "${FRESH_PROJECT}")
    file(REMOVE_RECURSE "${PROJECT}")
    file(MAKE_DIRECTORY "${PROJECT}")
endif()
if(RENAME_ENTRY)
    # The real environment, with its entry module renamed: the driver must follow environment.json.
    include("${ROOT}/cmake/WebFrontBootstrap.cmake")
    file(REMOVE_RECURSE "${WORK}/renamed")
    file(MAKE_DIRECTORY "${WORK}/renamed")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar xzf "${ENVIRONMENT}" WORKING_DIRECTORY "${WORK}/renamed" RESULT_VARIABLE unpacked)
    if(NOT unpacked EQUAL 0)
        message(FATAL_ERROR "Cannot unpack the environment")
    endif()
    file(RENAME "${WORK}/renamed/package/runtime.mjs" "${WORK}/renamed/package/${RENAME_ENTRY}")
    file(READ "${WORK}/renamed/package/environment.json" manifest)
    string(JSON manifest SET "${manifest}" entry "\"${RENAME_ENTRY}\"")
    file(WRITE "${WORK}/renamed/package/environment.json" "${manifest}")
    file(REMOVE "${WORK}/renamed.tgz")
    execute_process(COMMAND "${CMAKE_COMMAND}" -E tar czf "${WORK}/renamed.tgz" --format=gnutar package
        WORKING_DIRECTORY "${WORK}/renamed" RESULT_VARIABLE packed)
    if(NOT packed EQUAL 0)
        message(FATAL_ERROR "Cannot repack the environment")
    endif()
    set(ENVIRONMENT "${WORK}/renamed.tgz")
    webfront_file_sri("${ENVIRONMENT}" INTEGRITY)
endif()

set(arguments --project "${PROJECT}")
if(ENVIRONMENT)
    list(APPEND arguments --environment "${ENVIRONMENT}" --integrity "${INTEGRITY}")
endif()
if(REGISTRY)
    list(APPEND arguments --registry-dir "${REGISTRY}")
endif()
if(TIMEOUT)
    list(APPEND arguments --timeout "${TIMEOUT}")
endif()
if(EXPECT_REPORT)
    set(report "${PROJECT}/report.json")
    file(REMOVE "${report}")
    list(APPEND arguments --report "${report}")
endif()
if(EXPECT_FILE)
    file(REMOVE "${PROJECT}/${EXPECT_FILE}")
endif()
string(REPLACE "|" ";" command "${COMMAND}")
execute_process(COMMAND "${DRIVER}" ${arguments} -- ${command}
    RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE errors)
set(text "${output}${errors}")
message(STATUS "exit status ${status}\n${text}")
if(NOT status EQUAL EXPECT_STATUS)
    message(FATAL_ERROR "Expected exit status ${EXPECT_STATUS}, got ${status}")
endif()
if(EXPECT_OUTPUT AND NOT text MATCHES "${EXPECT_OUTPUT}")
    message(FATAL_ERROR "The output does not match '${EXPECT_OUTPUT}'")
endif()
if(EXPECT_REPORT)
    if(NOT EXISTS "${report}")
        message(FATAL_ERROR "The driver wrote no report")
    endif()
    file(READ "${report}" content)
    if(NOT content MATCHES "${EXPECT_REPORT}")
        message(FATAL_ERROR "The report does not match '${EXPECT_REPORT}': ${content}")
    endif()
endif()

if(EXPECT_FILE)
    if(NOT EXISTS "${PROJECT}/${EXPECT_FILE}")
        message(FATAL_ERROR "The command did not start: ${EXPECT_FILE} is missing")
    endif()
    file(READ "${PROJECT}/${EXPECT_FILE}" started)
    if(NOT started STREQUAL "running")
        message(FATAL_ERROR "The command did not record its running state")
    endif()
endif()
