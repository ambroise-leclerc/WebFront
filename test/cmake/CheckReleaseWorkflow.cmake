# Checks the permissions of .github/workflows/ReleaseDeveloper.yml against the table of ADR-021, decision 1 (acceptance
# criterion 4): no permission for the workflow as a whole, and exactly the permissions of the table for each job. The GitHub
# application's token is created only by the two jobs that the table gives it to, and the workflow carries no assistant
# attribution. WORKFLOW is the file to check (a mutated copy in the regression, FILE_UNDER_TEST of CheckReleaseWorkflowTests).
cmake_minimum_required(VERSION 3.31)
if(NOT WORKFLOW)
    message(FATAL_ERROR "WORKFLOW is required")
endif()

# job -> the permissions of its GITHUB_TOKEN, as "key: value" entries separated by "|".
set(expected_wf-package "contents: read")
set(expected_prepare "contents: read")
set(expected_tag "contents: write")
set(expected_publish "contents: write|pages: write")
set(expected_verify "contents: read")
set(expected_pull-request "contents: read")
set(jobs wf-package prepare tag publish verify pull-request)
# The jobs that create the application's token (the preparation and the pull request).
set(app_jobs prepare pull-request)

file(READ "${WORKFLOW}" content)
if(content MATCHES "[Cc]o-[Aa]uthored|[Gg]enerated with|Claude|Codex|Copilot")
    message(FATAL_ERROR "The workflow carries an assistant attribution")
endif()
string(REPLACE ";" "<SEMICOLON>" content "${content}")
string(REPLACE "\n" ";" lines "${content}")

set(job "")
set(in_permissions FALSE)
set(top_permissions "")
set(found_jobs "")
set(in_jobs FALSE)
foreach(line IN LISTS lines)
    if(line MATCHES "^permissions: *(.*)$")
        set(top_permissions "${CMAKE_MATCH_1}")
    endif()
    if(line MATCHES "^jobs:")
        set(in_jobs TRUE)
    endif()
    if(NOT in_jobs)
        continue()
    endif()
    if(line MATCHES "^  ([a-z][a-z-]*):[ ]*$")
        set(job "${CMAKE_MATCH_1}")
        list(APPEND found_jobs "${job}")
        set(actual_${job} "")
        set(has_permissions_${job} FALSE)
        set(in_permissions FALSE)
        continue()
    endif()
    if(job STREQUAL "")
        continue()
    endif()
    if(line MATCHES "^    permissions:[ ]*(.*)$")
        set(has_permissions_${job} TRUE)
        set(in_permissions TRUE)
        if(NOT "${CMAKE_MATCH_1}" STREQUAL "")
            message(FATAL_ERROR "Job ${job}: permissions must be a list of entries, not '${CMAKE_MATCH_1}'")
        endif()
        continue()
    endif()
    if(in_permissions)
        if(line MATCHES "^      ([a-z-]+: [a-z]+)[ ]*$")
            if(actual_${job})
                set(actual_${job} "${actual_${job}}|${CMAKE_MATCH_1}")
            else()
                set(actual_${job} "${CMAKE_MATCH_1}")
            endif()
            continue()
        endif()
        set(in_permissions FALSE)
    endif()
    if(line MATCHES "create-github-app-token")
        list(APPEND app_token_jobs "${job}")
    endif()
    if(line MATCHES "secrets\\.([A-Z_]+)" AND NOT job IN_LIST app_jobs)
        message(FATAL_ERROR "Job ${job} reads a secret (${CMAKE_MATCH_1}); only the jobs of the application's token may")
    endif()
endforeach()

if(NOT top_permissions STREQUAL "{}")
    message(FATAL_ERROR "The workflow must declare 'permissions: {}' at its top level, not '${top_permissions}'")
endif()
list(SORT found_jobs)
set(expected_jobs ${jobs})
list(SORT expected_jobs)
if(NOT found_jobs STREQUAL expected_jobs)
    message(FATAL_ERROR "The jobs of the workflow are '${found_jobs}', the table of ADR-021 has '${expected_jobs}'")
endif()
foreach(job IN LISTS jobs)
    if(NOT has_permissions_${job})
        message(FATAL_ERROR "Job ${job} declares no permissions of its own")
    endif()
    if(NOT "${actual_${job}}" STREQUAL "${expected_${job}}")
        message(FATAL_ERROR "Job ${job} has the permissions '${actual_${job}}', the table of ADR-021 gives '${expected_${job}}'")
    endif()
endforeach()
list(SORT app_token_jobs)
set(expected_app_jobs ${app_jobs})
list(SORT expected_app_jobs)
if(NOT app_token_jobs STREQUAL expected_app_jobs)
    message(FATAL_ERROR "The application's token is created by '${app_token_jobs}', not by '${expected_app_jobs}'")
endif()
message(STATUS "release-developer: permissions of ${found_jobs} match the table of ADR-021")

# The release commit is made on the commit that was built, and only the build job reads develop by name.
string(REGEX MATCHALL "ref: develop" develop_refs "${content}")
list(LENGTH develop_refs develop_count)
if(NOT develop_count EQUAL 1)
    message(FATAL_ERROR "Only wf-package may check out develop by name (${develop_count} found): the preparation must use its source commit")
endif()
if(NOT content MATCHES "needs[.]wf-package[.]outputs[.]source")
    message(FATAL_ERROR "The preparation does not check out the commit built by wf-package")
endif()
# The rehearsal runs the browser suite on the candidate bytes before anything is tagged.
if(NOT content MATCHES "ctest --test-dir build-driver -L web-integration")
    message(FATAL_ERROR "The rehearsal does not run the browser suite on the candidate bytes")
endif()
# CTest reads distribution.json when it configures: the build directory is configured again after the version is set.
if(NOT content MATCHES "cmake -S [.] -B build-driver\n")
    message(FATAL_ERROR "The rehearsal does not configure build-driver again after setting the version")
endif()
