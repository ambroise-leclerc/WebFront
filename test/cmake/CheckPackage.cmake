# Verify the archive prepared by wf for js/<DIRECTORY> contains the package's actual maintained sources.
# Usage: cmake -DROOT=<checkout> -DPROJECT=<self-build project> -DWORK=<scratch> -DDIRECTORY=<react|services>
#              -DLABEL=<name for messages> "-DFILES=<declared files>" -P CheckPackage.cmake
cmake_minimum_required(VERSION 3.31)
file(REMOVE_RECURSE "${WORK}")
file(READ "${ROOT}/js/${DIRECTORY}/package.json" manifest)
string(JSON package_version GET "${manifest}" version)
set(archive "${PROJECT}/build-${DIRECTORY}-package/webfront-${DIRECTORY}-${package_version}.tgz")
include("${ROOT}/cmake/WebFrontBootstrap.cmake")
webfront_file_sri("${archive}" actual_integrity)
file(READ "${PROJECT}/build-${DIRECTORY}-package/integrity.txt" expected_integrity)
string(STRIP "${expected_integrity}" expected_integrity)
if(NOT actual_integrity STREQUAL expected_integrity)
    message(FATAL_ERROR "${LABEL} package integrity.txt differs from the archive SHA-512")
endif()
file(SHA512 "${archive}" archive_hash)
file(SHA512 "${PROJECT}/build-registry/webfront-${DIRECTORY}-${package_version}.tgz" registry_hash)
if(NOT archive_hash STREQUAL registry_hash)
    message(FATAL_ERROR "${LABEL} registry tarball differs from wf run ${DIRECTORY}-package")
endif()
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${WORK}")
file(GLOB_RECURSE actual_files LIST_DIRECTORIES false RELATIVE "${WORK}" "${WORK}/*")
set(expected_files package/package.json)
set(names package.json)
foreach(name IN LISTS FILES)
    list(APPEND expected_files "package/${name}")
    list(APPEND names "${name}")
endforeach()
list(SORT actual_files)
list(SORT expected_files)
if(NOT actual_files STREQUAL expected_files)
    message(FATAL_ERROR "${LABEL} package file list differs: ${actual_files}")
endif()
foreach(name IN LISTS names)
    file(SHA256 "${ROOT}/js/${DIRECTORY}/${name}" expected)
    file(SHA256 "${WORK}/package/${name}" actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "${LABEL} package differs from sources: ${name}")
    endif()
endforeach()
file(SHA256 "${ROOT}/LICENSE" expected)
file(SHA256 "${WORK}/package/LICENSE" actual)
if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${LABEL} package license differs")
endif()
