# SemVer 2.0.0 precedence of the versions of the developer distribution (MAJOR.MINOR.PATCH[-prerelease], the names of
# distribution.json). CMake's VERSION_LESS and VERSION_EQUAL ignore the prerelease, so they cannot order 0.7.0-rc.2 and 0.7.0.
#   webfront_semver_compare(<a> <b> <variable>)   sets the variable to -1 (a precedes b), 0 (equal) or 1
# The same rules as compareVersions of js/developer/scripts/pin.mjs.

function(webfront_semver_parse version prefix)
    if(NOT version MATCHES "^([0-9]+)[.]([0-9]+)[.]([0-9]+)(-([0-9A-Za-z.-]+))?$")
        message(FATAL_ERROR "Invalid version '${version}'")
    endif()
    set(${prefix}_core "${CMAKE_MATCH_1};${CMAKE_MATCH_2};${CMAKE_MATCH_3}" PARENT_SCOPE)
    set(has_prerelease FALSE)
    if(CMAKE_MATCH_4)
        set(has_prerelease TRUE)
    endif()
    set(${prefix}_has_prerelease ${has_prerelease} PARENT_SCOPE)
    string(REPLACE "." ";" identifiers "${CMAKE_MATCH_5}")
    set(${prefix}_prerelease "${identifiers}" PARENT_SCOPE)
endfunction()

function(webfront_semver_compare a b result)
    webfront_semver_parse("${a}" left)
    webfront_semver_parse("${b}" right)
    foreach(index IN ITEMS 0 1 2)
        list(GET left_core ${index} x)
        list(GET right_core ${index} y)
        if(x LESS y)
            set(${result} -1 PARENT_SCOPE)
            return()
        elseif(x GREATER y)
            set(${result} 1 PARENT_SCOPE)
            return()
        endif()
    endforeach()
    # A prerelease precedes its release.
    if(NOT left_has_prerelease AND NOT right_has_prerelease)
        set(${result} 0 PARENT_SCOPE)
        return()
    elseif(left_has_prerelease AND NOT right_has_prerelease)
        set(${result} -1 PARENT_SCOPE)
        return()
    elseif(NOT left_has_prerelease AND right_has_prerelease)
        set(${result} 1 PARENT_SCOPE)
        return()
    endif()
    list(LENGTH left_prerelease left_length)
    list(LENGTH right_prerelease right_length)
    if(left_length LESS right_length)
        set(shared ${left_length})
    else()
        set(shared ${right_length})
    endif()
    math(EXPR last "${shared} - 1")
    foreach(index RANGE ${last})
        list(GET left_prerelease ${index} x)
        list(GET right_prerelease ${index} y)
        set(x_numeric FALSE)
        set(y_numeric FALSE)
        if(x MATCHES "^[0-9]+$")
            set(x_numeric TRUE)
        endif()
        if(y MATCHES "^[0-9]+$")
            set(y_numeric TRUE)
        endif()
        # Numbers compare as numbers and precede text; text compares in ASCII order.
        if(x_numeric AND y_numeric)
            if(x LESS y)
                set(${result} -1 PARENT_SCOPE)
                return()
            elseif(x GREATER y)
                set(${result} 1 PARENT_SCOPE)
                return()
            endif()
        elseif(x_numeric)
            set(${result} -1 PARENT_SCOPE)
            return()
        elseif(y_numeric)
            set(${result} 1 PARENT_SCOPE)
            return()
        elseif(x STRLESS y)
            set(${result} -1 PARENT_SCOPE)
            return()
        elseif(x STRGREATER y)
            set(${result} 1 PARENT_SCOPE)
            return()
        endif()
    endforeach()
    # With equal leading identifiers, the shorter list precedes the longer one.
    if(left_length LESS right_length)
        set(${result} -1 PARENT_SCOPE)
    elseif(left_length GREATER right_length)
        set(${result} 1 PARENT_SCOPE)
    else()
        set(${result} 0 PARENT_SCOPE)
    endif()
endfunction()
