# Exercise the opt-in API documentation target without building the library or downloading packages.
cmake_minimum_required(VERSION 3.31)
if(NOT ROOT OR NOT WORK)
    message(FATAL_ERROR "ROOT and WORK are required")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/source/include")
file(WRITE "${WORK}/source/include/Example.hpp" "/** @brief Documentation fixture. */\nstruct Example {};\n")
file(WRITE "${WORK}/source/CMakeLists.txt" "cmake_minimum_required(VERSION 3.31)\nproject(Docs VERSION 7.8.9 LANGUAGES NONE)\ninclude(\"${ROOT}/cmake/Doxygen.cmake\")\nenable_doxygen()\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK}/source" -B "${WORK}/build" -DENABLE_DOXYGEN=ON
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Doxygen configuration failed: ${output}${error}")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/build" --target doc_doxygen
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0 OR NOT EXISTS "${WORK}/build/html/annotated.html")
    message(FATAL_ERROR "The documentation target did not generate the public API: ${output}${error}")
endif()
file(READ "${WORK}/build/html/annotated.html" classes)
if(NOT classes MATCHES "Example")
    message(FATAL_ERROR "The documentation must include the public header")
endif()
file(READ "${WORK}/build/html/index.html" index)
if(NOT index MATCHES "7.8.9")
    message(FATAL_ERROR "The documentation must use the configured project version")
endif()
