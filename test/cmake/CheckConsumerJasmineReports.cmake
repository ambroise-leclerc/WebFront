foreach(mode pass fail empty pending broken)
    file(READ "${DIRECTORY}/ConsumerJasmine-${mode}/report.json" report)
    string(JSON status GET "${report}" status)
    if(mode STREQUAL "broken")
        string(JSON detail GET "${report}" error)
        if(NOT status STREQUAL "error" OR NOT detail MATCHES "failed to load")
            message(FATAL_ERROR "Broken consumer spec was not reported as a load error: ${report}")
        endif()
        continue()
    endif()
    string(JSON total GET "${report}" total)
    string(JSON failed GET "${report}" failed)
    if(mode STREQUAL "pass")
        if(NOT status STREQUAL "passed" OR NOT total EQUAL 1 OR NOT failed EQUAL 0)
            message(FATAL_ERROR "Passing consumer did not execute its spec: ${report}")
        endif()
    elseif(mode STREQUAL "fail")
        if(NOT status STREQUAL "failed" OR NOT total EQUAL 1 OR NOT failed EQUAL 1)
            message(FATAL_ERROR "Failing consumer failed for the wrong reason: ${report}")
        endif()
        string(JSON failure GET "${report}" failures 0)
        if(NOT failure MATCHES "A failing consumer reports the failure:.*Expected 1 to be 2")
            message(FATAL_ERROR "Failing consumer lost its spec name or diagnostic: ${report}")
        endif()
    elseif(NOT status STREQUAL "failed" OR NOT total EQUAL 0)
        message(FATAL_ERROR "The ${mode} consumer failed for the wrong reason: ${report}")
    endif()
endforeach()
foreach(mode unicode report-bounds)
    set(expected 5)
    if(mode STREQUAL "report-bounds")
        set(expected 50)
    endif()
    file(READ "${DIRECTORY}/ConsumerJasmine-${mode}/report.json" report)
    string(LENGTH "${report}" bytes)
    string(JSON status GET "${report}" status)
    string(JSON total GET "${report}" total)
    string(JSON failed GET "${report}" failed)
    string(JSON recorded LENGTH "${report}" failures)
    if(NOT status STREQUAL "failed" OR NOT total EQUAL expected OR NOT failed EQUAL expected
       OR NOT recorded EQUAL expected OR bytes GREATER 60001)
        message(FATAL_ERROR "The ${mode} report lost failures or exceeded its byte budget: ${report}")
    endif()
    if(mode STREQUAL "unicode")
        foreach(index RANGE 0 2)
            string(JSON failure GET "${report}" failures ${index})
            if(NOT failure MATCHES "^Unicode reports 😀 ")
                message(FATAL_ERROR "Unicode spec name was damaged: ${failure}")
            endif()
            if(index GREATER 0 AND NOT failure MATCHES "surrogate: �")
                message(FATAL_ERROR "Isolated surrogate was not normalized: ${failure}")
            endif()
        endforeach()
        string(REPEAT "x" 3000 long_name)
        string(JSON failure GET "${report}" failures 3)
        if(NOT failure STREQUAL "Unicode reports 😀 long-name-${long_name}-end: Failed: short diagnostic")
            message(FATAL_ERROR "A full spec name that fits the budget was shortened: ${failure}")
        endif()
        string(ASCII 239 187 191 bom)
        string(JSON failure GET "${report}" failures 4)
        if(NOT failure STREQUAL "${bom}top-level name: Failed: keeps a leading U+FEFF")
            message(FATAL_ERROR "Valid Unicode was changed while normalizing the report: ${failure}")
        endif()
    else()
        string(JSON truncated GET "${report}" truncated)
        if(NOT truncated)
            message(FATAL_ERROR "Report shortening was not made explicit")
        endif()
        foreach(index RANGE 0 49)
            string(JSON failure GET "${report}" failures ${index})
            if(NOT failure MATCHES "^Bounded reports failure ${index} 😀: Failed: diagnostic ${index}: ")
                message(FATAL_ERROR "Full spec name or diagnostic prefix was lost: ${failure}")
            endif()
        endforeach()
    endif()
endforeach()
foreach(mode close hang)
    if(EXISTS "${DIRECTORY}/ConsumerJasmine-${mode}/report.json")
        message(FATAL_ERROR "The ${mode} consumer unexpectedly reported a result")
    endif()
endforeach()
