# cmake/DeveloperCompatibility.cmake rewrites the unreleased row, freezes it into a library version's row, and refuses
# a malformed or repeated version (ADR-021, decision 4). It runs on a copy of the three files it reads, never on ROOT.
cmake_minimum_required(VERSION 3.31)
if(NOT ROOT OR NOT WORK)
    message(FATAL_ERROR "ROOT and WORK are required")
endif()
set(copy "${WORK}/copy")
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${copy}/docs" "${copy}/include/webfront/system")
file(WRITE "${copy}/include/webfront/system/DeveloperReleaseData.hpp" "inline constexpr std::string_view version{\"0.6.9\"};\n")
file(WRITE "${copy}/include/webfront/DeveloperApp.hpp" "inline constexpr int apiVersion      = 2;\n")
set(table_begin "<!-- compatibility-table:begin -->\n| Library | Environment | Minimum api |\n| --- | --- | --- |\n")
set(table_end "<!-- compatibility-table:end -->\n")
file(WRITE "${copy}/docs/DEVELOPER_ENVIRONMENT.md" "text\n${table_begin}| unreleased | 0.6.1 | 1 |\n| 0.5.0 | 0.6.0 | 1 |\n${table_end}more\n")

function(run result_variable)
    execute_process(COMMAND "${CMAKE_COMMAND}" -DROOT=${copy} ${ARGN} -P "${ROOT}/cmake/DeveloperCompatibility.cmake"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    set(${result_variable} ${result} PARENT_SCOPE)
    set(last_output "${output}${error}" PARENT_SCOPE)
endfunction()
function(document variable)
    file(READ "${copy}/docs/DEVELOPER_ENVIRONMENT.md" content)
    set(${variable} "${content}" PARENT_SCOPE)
endfunction()

run(status -DMODE=unreleased)
document(content)
if(NOT status EQUAL 0 OR NOT content MATCHES "[|] unreleased [|] 0[.]6[.]9 [|] 2 [|]")
    message(FATAL_ERROR "The unreleased row was not rewritten: ${last_output}")
endif()
foreach(bad IN ITEMS 1x2y3 1.2 v1.2.3 1.2.3.4)
    document(before)
    run(status -DMODE=freeze "-DLIBRARY_VERSION=${bad}")
    document(after)
    if(status EQUAL 0 OR NOT before STREQUAL after)
        message(FATAL_ERROR "The malformed version '${bad}' was accepted or changed the table")
    endif()
endforeach()
run(status -DMODE=freeze -DLIBRARY_VERSION=1.2.3)
document(content)
if(NOT status EQUAL 0 OR NOT content MATCHES "\n[|] unreleased [|] 0[.]6[.]9 [|] 2 [|]\n[|] 1[.]2[.]3 [|] 0[.]6[.]9 [|] 2 [|]\n[|] 0[.]5[.]0 ")
    message(FATAL_ERROR "The row was not frozen under the unreleased one: ${last_output}\n${content}")
endif()
run(status -DMODE=freeze -DLIBRARY_VERSION=1.2.3)
if(status EQUAL 0)
    message(FATAL_ERROR "A repeated freeze was accepted")
endif()
# The library version may equal the environment's (one number for both): only the first cell of a row is a library.
run(status -DMODE=freeze -DLIBRARY_VERSION=0.6.9)
document(content)
if(NOT status EQUAL 0 OR NOT content MATCHES "
[|] 0[.]6[.]9 [|] 0[.]6[.]9 [|] 2 [|]
")
    message(FATAL_ERROR "A library version equal to the environment's was refused: ${last_output}")
endif()
file(REMOVE_RECURSE "${WORK}")
