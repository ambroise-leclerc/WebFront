# The local CI matrix (cmake/local-ci/lanes.json, #346) has to describe every lane the GitHub workflows expand to: it fails on a job
# without lane, a lane without job, a different matrix, CMake version, compiler, option, target, CTest label, test step or mddlog
# revision. The local differences (cache, parallelism, toolchain, runner images, GitHub-only steps) are declared in the file and
# documented in docs/LOCAL_CI.md, which has to name every lane. Offline: the workflows are read as text.
#   cmake -DROOT=<checkout> [-DWORKFLOWS_DIR=<dir>] [-DLANES_FILE=<file>] [-DDOC_FILE=<file>] -P test/cmake/CheckLocalCi.cmake
cmake_minimum_required(VERSION 3.31)
include("${CMAKE_CURRENT_LIST_DIR}/LocalCiCommands.cmake")

if(NOT ROOT)
    message(FATAL_ERROR "ROOT is required")
endif()
if(NOT WORKFLOWS_DIR)
    set(WORKFLOWS_DIR "${ROOT}/.github/workflows")
endif()
if(NOT LANES_FILE)
    set(LANES_FILE "${ROOT}/cmake/local-ci/lanes.json")
endif()
if(NOT DOC_FILE)
    set(DOC_FILE "${ROOT}/docs/LOCAL_CI.md")
endif()

# A global property, so that checks made inside helper functions are not lost with their scope.
set_property(GLOBAL PROPERTY local_ci_problems "")
function(report message)
    set_property(GLOBAL APPEND_STRING PROPERTY local_ci_problems "\n  - ${message}")
endfunction()

if(NOT EXISTS "${LANES_FILE}")
    message(FATAL_ERROR "Missing ${LANES_FILE}")
endif()
file(READ "${LANES_FILE}" lanes_json)
string(JSON schema GET "${lanes_json}" schema)
if(NOT schema EQUAL 1)
    message(FATAL_ERROR "Unsupported lanes.json schema: ${schema}")
endif()

# The mandatory declaration of the local differences.
foreach(difference parallelism cache toolchain runner_images)
    string(JSON text ERROR_VARIABLE err GET "${lanes_json}" local_differences ${difference})
    if(err OR text STREQUAL "")
        report("local_differences.${difference} is not declared")
    endif()
endforeach()
string(JSON github_only ERROR_VARIABLE err LENGTH "${lanes_json}" local_differences github_only_steps)
if(err OR github_only EQUAL 0)
    report("local_differences.github_only_steps is not declared")
endif()

# Splits the jobs: section of a workflow into one text per job (written to <prefix>_<job>), and returns the job names.
function(read_jobs workflow out_names prefix)
    file(READ "${WORKFLOWS_DIR}/${workflow}" text)
    string(FIND "${text}" "\njobs:\n" start)
    if(start EQUAL -1)
        message(FATAL_ERROR "${workflow} has no jobs: section")
    endif()
    string(SUBSTRING "${text}" ${start} -1 jobs_text)
    string(REGEX MATCHALL "\n  [A-Za-z][A-Za-z0-9_-]*:\n" headers "${jobs_text}")
    set(names "")
    set(positions "")
    foreach(header IN LISTS headers)
        string(FIND "${jobs_text}" "${header}" position)
        string(STRIP "${header}" stripped)
        string(REGEX REPLACE ":$" "" job "${stripped}")
        list(APPEND names "${job}")
        list(APPEND positions ${position})
    endforeach()
    list(LENGTH names count)
    set(index 0)
    foreach(job IN LISTS names)
        list(GET positions ${index} begin)
        math(EXPR next "${index} + 1")
        if(next LESS count)
            list(GET positions ${next} finish)
        else()
            string(LENGTH "${jobs_text}" finish)
        endif()
        math(EXPR size "${finish} - ${begin}")
        string(SUBSTRING "${jobs_text}" ${begin} ${size} block)
        set(${prefix}_${job} "${block}" PARENT_SCOPE)
        math(EXPR index "${index} + 1")
    endforeach()
    set(${out_names} "${names}" PARENT_SCOPE)
endfunction()

# The values of a matrix: an inline list `key: [a, b]` or the `- key: value` entries of an include list.
function(matrix_values block key out)
    set(values "")
    if(block MATCHES "[ \n]${key}: \\[([^]\n]*)\\]")
        string(REPLACE "," ";" values "${CMAKE_MATCH_1}")
    else()
        # Only the strategy: step names are `- name:` entries too.
        string(FIND "${block}" "matrix:" from)
        string(FIND "${block}" "\n    steps:" to)
        set(strategy "")
        if(from GREATER -1 AND to GREATER from)
            math(EXPR size "${to} - ${from}")
            string(SUBSTRING "${block}" ${from} ${size} strategy)
        endif()
        string(REGEX MATCHALL "- ${key}: [A-Za-z0-9_-]+" entries "${strategy}")
        foreach(entry IN LISTS entries)
            string(REGEX REPLACE "^- ${key}: " "" value "${entry}")
            list(APPEND values "${value}")
        endforeach()
    endif()
    set(cleaned "")
    foreach(value IN LISTS values)
        string(STRIP "${value}" value)
        list(APPEND cleaned "${value}")
    endforeach()
    set(${out} "${cleaned}" PARENT_SCOPE)
endfunction()

function(require_text block lane what text)
    string(FIND "${block}" "${text}" found)
    if(found EQUAL -1)
        report("lane ${lane}: ${what} '${text}' is not in the workflow job")
    endif()
endfunction()

function(json_strings json out)
    string(JSON count ERROR_VARIABLE err LENGTH "${json}")
    set(items "")
    if(NOT err AND count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(i RANGE ${last})
            string(JSON item GET "${json}" ${i})
            list(APPEND items "${item}")
        endforeach()
    endif()
    set(${out} "${items}" PARENT_SCOPE)
endfunction()

# Jobs and matrices of every workflow against the declaration.
string(JSON lane_count LENGTH "${lanes_json}" lanes)
math(EXPR lane_last "${lane_count} - 1")
string(JSON workflow_count LENGTH "${lanes_json}" workflows)
math(EXPR workflow_last "${workflow_count} - 1")
set(lane_ids "")
set(lane_keys "")
foreach(i RANGE ${lane_last})
    string(JSON id GET "${lanes_json}" lanes ${i} id)
    string(JSON workflow GET "${lanes_json}" lanes ${i} workflow)
    string(JSON job GET "${lanes_json}" lanes ${i} job)
    string(JSON matrix GET "${lanes_json}" lanes ${i} matrix)
    list(APPEND lane_ids "${id}")
    list(APPEND lane_keys "${workflow}|${job}|${matrix}")
endforeach()
list(LENGTH lane_ids id_count)
list(REMOVE_DUPLICATES lane_ids)
list(LENGTH lane_ids unique_ids)
if(NOT id_count EQUAL unique_ids)
    report("lane ids are not unique")
endif()

set(expected_keys "")
foreach(w RANGE ${workflow_last})
    string(JSON workflow MEMBER "${lanes_json}" workflows ${w})
    if(NOT EXISTS "${WORKFLOWS_DIR}/${workflow}")
        report("workflow ${workflow} is declared but missing")
        continue()
    endif()
    read_jobs("${workflow}" actual_jobs "job_${w}")
    string(JSON declared_json GET "${lanes_json}" workflows "${workflow}" jobs)
    json_strings("${declared_json}" declared_jobs)
    foreach(job IN LISTS actual_jobs)
        if(NOT job IN_LIST declared_jobs)
            report("${workflow}: job '${job}' has no lane declaration")
        endif()
    endforeach()
    foreach(job IN LISTS declared_jobs)
        if(NOT job IN_LIST actual_jobs)
            report("${workflow}: declared job '${job}' does not exist")
            continue()
        endif()
        string(JSON matrix_json ERROR_VARIABLE err GET "${lanes_json}" workflows "${workflow}" matrices "${job}")
        if(err OR matrix_json STREQUAL "" OR matrix_json MATCHES "NOTFOUND")
            list(APPEND expected_keys "${workflow}|${job}|")
            if("${job_${w}_${job}}" MATCHES "matrix:")
                report("${workflow}: job '${job}' has a matrix that is not declared")
            endif()
            continue()
        endif()
        string(JSON key GET "${matrix_json}" key)
        string(JSON values_json GET "${matrix_json}" values)
        json_strings("${values_json}" declared_values)
        lane_matrix("${job_${w}_${job}}" "${key}" "" unused_entry unused_block)
        matrix_values("${job_${w}_${job}}" "${key}" actual_values)
        list(LENGTH actual_values actual_count)
        set(unique_values "${actual_values}")
        list(REMOVE_DUPLICATES unique_values)
        list(LENGTH unique_values unique_count)
        if(NOT actual_count EQUAL unique_count)
            report("${workflow}: ${job} matrix has duplicate values")
        endif()
        foreach(value IN LISTS actual_values)
            if(NOT value IN_LIST declared_values)
                report("${workflow}: ${job} matrix value '${value}' has no lane declaration")
            endif()
        endforeach()
        foreach(value IN LISTS declared_values)
            if(NOT value IN_LIST actual_values)
                report("${workflow}: declared ${job} matrix value '${value}' does not exist")
            endif()
            list(APPEND expected_keys "${workflow}|${job}|${value}")
        endforeach()
    endforeach()
endforeach()
foreach(key IN LISTS expected_keys)
    list(FIND lane_keys "${key}" first)
    if(first EQUAL -1)
        report("no lane for ${key}")
    endif()
endforeach()
foreach(key IN LISTS lane_keys)
    if(NOT key IN_LIST expected_keys)
        report("lane ${key} matches no job or matrix value")
    endif()
endforeach()
list(LENGTH lane_keys key_count)
list(REMOVE_DUPLICATES lane_keys)
list(LENGTH lane_keys unique_keys)
if(NOT key_count EQUAL unique_keys)
    report("two lanes describe the same job and matrix value")
endif()

# Every lane against the text of its job.
foreach(i RANGE ${lane_last})
    string(JSON id GET "${lanes_json}" lanes ${i} id)
    string(JSON workflow GET "${lanes_json}" lanes ${i} workflow)
    string(JSON job GET "${lanes_json}" lanes ${i} job)
    string(JSON matrix GET "${lanes_json}" lanes ${i} matrix)
    string(JSON build_type GET "${lanes_json}" lanes ${i} build_type)
    string(JSON cmake_version GET "${lanes_json}" lanes ${i} cmake_version)
    string(JSON marker GET "${lanes_json}" lanes ${i} compiler marker)
    string(JSON machine GET "${lanes_json}" lanes ${i} machine)
    if(NOT machine MATCHES "^(RyzenLinux|CurmudgeonWindows|Mac)$")
        report("lane ${id}: unknown machine '${machine}'")
    endif()
    set(block "")
    foreach(w RANGE ${workflow_last})
        string(JSON name MEMBER "${lanes_json}" workflows ${w})
        if(name STREQUAL workflow AND DEFINED job_${w}_${job})
            set(block "${job_${w}_${job}}")
            set(workflow_index ${w})
        endif()
    endforeach()
    if(block STREQUAL "")
        continue()
    endif()

    set(entry "${block}")
    if(NOT matrix STREQUAL "")
        string(JSON key GET "${lanes_json}" workflows "${workflow}" matrices "${job}" key)
        lane_matrix("${block}" "${key}" "${matrix}" entry block)
    endif()
    string(JSON lane GET "${lanes_json}" lanes ${i})
    check_lane_commands("${block}" "${lane}")

    if(entry MATCHES "build_type: ([A-Za-z]+)")
        if(NOT CMAKE_MATCH_1 STREQUAL build_type)
            report("lane ${id}: build type ${build_type}, workflow has ${CMAKE_MATCH_1}")
        endif()
    else()
        require_text("${block}" "${id}" "build type" "-DCMAKE_BUILD_TYPE=${build_type}")
    endif()

    # CMake versions: every setup-cmake of the job.
    string(REGEX MATCHALL "[ ]version: '[0-9.]+'" versions "${block}")
    if(NOT versions)
        report("lane ${id}: the job installs no pinned CMake")
    endif()
    foreach(version IN LISTS versions)
        if(NOT version MATCHES "'${cmake_version}'")
            report("lane ${id}: CMake ${cmake_version}, workflow has ${version}")
        endif()
    endforeach()

    if(NOT marker STREQUAL "")
        require_text("${block}" "${id}" "compiler" "${marker}")
    endif()

    string(JSON env_json GET "${lanes_json}" lanes ${i} env)
    string(JSON env_count LENGTH "${env_json}")
    if(env_count GREATER 0)
        math(EXPR env_last "${env_count} - 1")
        foreach(e RANGE ${env_last})
            string(JSON env_key MEMBER "${env_json}" ${e})
            string(JSON env_value GET "${env_json}" "${env_key}")
            require_text("${block}" "${id}" "environment variable" "${env_key}")
            require_text("${block}" "${id}" "environment value" "${env_value}")
        endforeach()
    endif()

    string(JSON flags ERROR_VARIABLE err GET "${lanes_json}" lanes ${i} sanitizer_flags)
    if(NOT err)
        require_text("${block}" "${id}" "sanitizer flags" "${flags}")
    endif()
    string(JSON sysctl_json ERROR_VARIABLE err GET "${lanes_json}" lanes ${i} host_requirements sysctl)
    if(NOT err)
        string(JSON sysctl_key MEMBER "${sysctl_json}" 0)
        string(JSON sysctl_value GET "${sysctl_json}" "${sysctl_key}")
        require_text("${block}" "${id}" "sysctl" "${sysctl_key}=${sysctl_value}")
    endif()

    string(JSON fuzz_json ERROR_VARIABLE err GET "${lanes_json}" lanes ${i} fuzz_decoders)
    if(NOT err)
        json_strings("${fuzz_json}" decoders)
        string(REPLACE ";" " " decoder_text "${decoders}")
        require_text("${block}" "${id}" "fuzzed decoders" "for decoder in ${decoder_text}")
        string(JSON fuzz_seconds GET "${lanes_json}" lanes ${i} fuzz_seconds)
        require_text("${block}" "${id}" "fuzz duration" "-max_total_time=${fuzz_seconds}")
    endif()

    string(JSON evidence_json GET "${lanes_json}" lanes ${i} evidence)
    json_strings("${evidence_json}" evidence)
    foreach(text IN LISTS evidence)
        require_text("${block}" "${id}" "step" "${text}")
    endforeach()

    # The pinned mddlog revision of the Mddlog workflow.
    if(workflow STREQUAL "MddlogIntegration.yml")
        string(JSON mddlog_ref GET "${lanes_json}" mddlog ref)
        string(JSON mddlog_repository GET "${lanes_json}" mddlog repository)
        require_text("${block}" "${id}" "mddlog revision" "ref: ${mddlog_ref}")
        require_text("${block}" "${id}" "mddlog repository" "repository: ${mddlog_repository}")
        string(REGEX MATCHALL "ref: [0-9a-f]+" refs "${block}")
        foreach(ref IN LISTS refs)
            if(NOT ref STREQUAL "ref: ${mddlog_ref}")
                report("lane ${id}: workflow pins ${ref}, lanes.json pins ${mddlog_ref}")
            endif()
        endforeach()
    endif()
endforeach()

# The documentation names every lane.
if(EXISTS "${DOC_FILE}")
    file(READ "${DOC_FILE}" doc)
    foreach(id IN LISTS lane_ids)
        string(FIND "${doc}" "`${id}`" found)
        if(found EQUAL -1)
            report("${DOC_FILE} does not document lane ${id}")
        endif()
    endforeach()
else()
    report("missing ${DOC_FILE}")
endif()

get_property(problems GLOBAL PROPERTY local_ci_problems)
if(problems)
    message(FATAL_ERROR "cmake/local-ci/lanes.json drifted from the workflows:${problems}")
endif()
message(STATUS "${lane_count} local CI lanes match ${WORKFLOWS_DIR}")
