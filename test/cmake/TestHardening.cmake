# Deliberately separate from WebFront and WebFront_options: only test/fuzz targets opt in.
include(CheckCXXSourceCompiles)
include(CheckCXXCompilerFlag)

add_library(WebFront_test_hardening INTERFACE)
foreach(_stdlib IN ITEMS GLIBCXX LIBCPP MSVC_STL)
    if(_stdlib STREQUAL "GLIBCXX")
        set(_macro __GLIBCXX__)
        set(_definition _GLIBCXX_ASSERTIONS)
    elseif(_stdlib STREQUAL "LIBCPP")
        set(_macro _LIBCPP_VERSION)
        set(_definition _LIBCPP_HARDENING_MODE=_LIBCPP_HARDENING_MODE_EXTENSIVE)
    else()
        set(_macro _MSVC_STL_VERSION)
        set(_definition _MSVC_STL_HARDENING=1)
    endif()
    check_cxx_source_compiles("#include <version>\n#ifndef ${_macro}\n#error Different standard library\n#endif\nint main() {}" WEBFRONT_TEST_USES_${_stdlib})
    if(WEBFRONT_TEST_USES_${_stdlib})
        target_compile_definitions(WebFront_test_hardening INTERFACE ${_definition})
    endif()
endforeach()

if(CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" AND NOT MSVC)
    check_cxx_compiler_flag(-ftrivial-auto-var-init=pattern WEBFRONT_HAS_AUTO_VAR_INIT)
    if(WEBFRONT_HAS_AUTO_VAR_INIT)
        target_compile_options(WebFront_test_hardening INTERFACE -ftrivial-auto-var-init=pattern)
    else()
        message(WARNING "Compiler does not support -ftrivial-auto-var-init=pattern; test variables will not be pattern-initialized")
    endif()
endif()
