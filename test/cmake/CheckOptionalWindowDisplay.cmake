cmake_minimum_required(VERSION 3.31)
include("${ROOT}/cmake/Frontends.cmake")
set(CMAKE_SYSTEM_NAME Linux)
# An explicit empty cache entry makes the test independent of the host's PATH.
set(XVFB_RUN_EXECUTABLE "" CACHE FILEPATH "" FORCE)
if(REQUIRE_BROWSER)
    set(WEBFRONT_EMBED_CEF ON)
    webfront_require_browser_test_display(CEF)
    message(FATAL_ERROR "Mandatory browser registration unexpectedly succeeded")
endif()
webfront_optional_window_test_runner(prefix available)
if(available OR prefix)
    message(FATAL_ERROR "Missing xvfb-run must skip optional window regressions")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -DROOT=${ROOT} -DREQUIRE_BROWSER=ON -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "mandatory browser coverage[ \n]+cannot be skipped")
    message(FATAL_ERROR "Missing display must fail mandatory browser registration: ${output}${error}")
endif()
set(XVFB_RUN_EXECUTABLE "/synthetic/xvfb-run" CACHE FILEPATH "" FORCE)
webfront_optional_window_test_runner(prefix available)
list(LENGTH prefix length)
if(NOT available OR NOT length EQUAL 2)
    message(FATAL_ERROR "A supplied display runner must enable and wrap optional regressions")
endif()
set(CMAKE_SYSTEM_NAME Darwin)
set(XVFB_RUN_EXECUTABLE "" CACHE FILEPATH "" FORCE)
webfront_optional_window_test_runner(prefix available)
if(NOT available OR prefix)
    message(FATAL_ERROR "macOS must not depend on xvfb-run")
endif()
