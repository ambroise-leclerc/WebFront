# Keep the two public examples, README commands and frontend option reference in sync.
cmake_minimum_required(VERSION 3.31)
if(NOT ROOT)
    message(FATAL_ERROR "ROOT must point at the WebFront checkout")
endif()
function(_read var path)
    file(READ "${ROOT}/${path}" content)
    string(REPLACE "\r\n" "\n" content "${content}")
    set(${var} "${content}" PARENT_SCOPE)
endfunction()
set(failures "")
function(_require haystack needle description)
    string(FIND "${haystack}" "${needle}" position)
    if(position EQUAL -1)
        list(APPEND failures "${description}: missing '${needle}'")
        set(failures "${failures}" PARENT_SCOPE)
    endif()
endfunction()
_read(readme README.md)
_read(agents AGENTS.md)
_read(life examples/life/LifeDeveloper.cpp)
_read(embedded examples/life/LifeEmbedded.cpp)
_read(examples examples/CMakeLists.txt)
_read(root CMakeLists.txt)
_read(test_options cmake/WebFrontTestOptions.cmake)
_read(ci .github/workflows/BuildAndTest.yml)
_read(frontends docs/FRONTENDS.md)
_read(developer_guide docs/DEVELOPER_ENVIRONMENT.md)
_read(wkwebview_guide docs/WKWEBVIEW.md)
_read(developer_release include/webfront/system/DeveloperReleaseData.hpp)
# The README starts the example on the environment pinned in the release data; only the guides of the maintainers and of
# WKWebView show the explicit local archive, which must not silently use an unpublished default.
_require("${readme}" "```bash\nexamples/WebFrontLifeDeveloper\n```" "README starts the example without argument")
_require("${readme}" "-DWEBFRONT_AUTODETECT_NATIVE=OFF" "README advanced native selection")
_require("${root}" "webfront_autodetect_native_frontends()" "native engine autodetection")
foreach(option WEBFRONT_EMBED_WEBVIEW2 WEBFRONT_EMBED_WKWEBVIEW WEBFRONT_EMBED_WEBKITGTK)
    _require("${readme}" "-D${option}=ON|OFF" "README explicit engine choice")
endforeach()
_require("${life}" "parseLifeDeveloperOptions" "default project and explicit arguments")
foreach(text developer_guide wkwebview_guide)
    _require("${${text}}" "/webfront/developer/preview/provision/environment.tgz \"$integrity\"" "${text} local bootstrap arguments")
    _require("${${text}}" "sed -n 's/^  \"integrity\": \"\\(.*\\)\",$/\\1/p' build-developer-environment/provision.json" "${text} trusted local integrity")
endforeach()
string(REGEX MATCH "https://[^\"]+/environment\\.tgz" developer_url "${developer_release}")
if(NOT developer_url)
    list(APPEND failures "Cannot read the pinned developer environment URL")
else()
    _require("${developer_guide}" "${developer_url}" "documented default developer environment")
endif()

_require("${root}" "add_subdirectory(examples)" "examples directory")
_require("${root}" "webfront_declare_test_options(\${WEBFRONT_IS_TOP_LEVEL})" "test options")
_require("${test_options}" "option(WEBFRONT_ENABLE_TESTING \"Build WebFront's tests\" OFF)" "tests opt-in")
_require("${root}" "add_library(WebFront::WebFront ALIAS WebFront)" "consumer alias")
_require("${readme}" "target_link_libraries(MyApp PRIVATE WebFront::WebFront)" "consumer instructions")
_require("${readme}" "mkdir build\ncd build\ncmake ..\ncmake --build .\n" "Life standard build")
foreach(line "app.cppFunction(\"life.step\", &webfront::demo::nextLife);" "app.bootstrap(\"developer\");" "app.show();")
    _require("${readme}" "${line}" "Life bootstrap snippet")
    _require("${life}" "${line}" "compiled Life bootstrap")
endforeach()
foreach(line "#include <bitset>" "Grid nextLife(const Grid& cells)" "app.cppFunction(\"life.step\", &nextLife);")
    _require("${readme}" "${line}" "self-contained introductory Life application")
endforeach()
_require("${readme}" "webfront::demo::LifeApp app{\"life-project\"};" "developer application snippet")
_require("${readme}" "webfront::demo::LifeAppWithAssets<webfront::fs::LifeUI> app;" "offline application snippet")
_require("${embedded}" "webfront::demo::LifeAppWithAssets<webfront::fs::LifeUI> app;" "compiled offline application")
foreach(target HelloWorld WebFrontLifeConsole WebFrontLifeDeveloper WebFrontLifeEmbedded WebFrontLifeReact)
    _require("${examples}" "add_executable(${target} " "compiled example stage")
    if(NOT target STREQUAL "HelloWorld")
        _require("${readme}" "${target}" "documented Life stage")
    endif()
endforeach()
string(REGEX MATCHALL "add_executable\\(" targets "${examples}")
list(LENGTH targets target_count)
if(NOT target_count EQUAL 5)
    list(APPEND failures "Only Hello World, the three Life stages and the React adapter variant should be built")
endif()
foreach(command "wf create life" "wf init" "wf install react@19.3.1 react-dom@19.3.1" "wf dev ui/main.tsx" "wf check" "wf test" "wf embed ui/main.tsx --output generated/LifeUI.hpp")
    _require("${readme}" "${command}" "developer-terminal walkthrough")
endforeach()
_require("${readme}" "-DWEBFRONT_LIFE_ASSETS=\"$PWD/life-project/generated/LifeUI.hpp\"" "generated-header build")
_require("${readme}" "src=\"docs/images/life-bootstrap.gif\" width=\"100%\"" "early Life animation")
foreach(path examples/hello-world/HelloWorld.cpp examples/life/Life.hpp examples/life/ui/main.tsx docs/images/life-preview.jpg docs/images/life-bootstrap.gif)
    if(NOT EXISTS "${ROOT}/${path}")
        list(APPEND failures "missing walkthrough asset ${path}")
    endif()
endforeach()
# Option declarations stay opt-in and their plain help is documented in the frontend reference.
include("${ROOT}/cmake/Frontends.cmake")
foreach(name IN LISTS WEBFRONT_FRONTEND_REGISTRY)
    set(option "${WEBFRONT_FRONTEND_${name}_OPTION}")
    if(NOT option STREQUAL "")
        unset(${option})
        unset(${option} CACHE)
    endif()
endforeach()
webfront_declare_frontend_options()
string(REPLACE "`" "" frontends "${frontends}")
foreach(name IN LISTS WEBFRONT_FRONTEND_REGISTRY)
    set(option "${WEBFRONT_FRONTEND_${name}_OPTION}")
    if(option STREQUAL "")
        continue()
    endif()
    get_property(default CACHE ${option} PROPERTY VALUE)
    get_property(description CACHE ${option} PROPERTY HELPSTRING)
    if(NOT default STREQUAL "OFF" OR description MATCHES "`")
        list(APPEND failures "${option} must default to OFF with plain help text")
    endif()
    _require("${frontends}" "| ${option} | ${default} | ${description} |" "frontend option reference")
endforeach()
foreach(text readme agents ci)
    _require("${${text}}" "-DWEBFRONT_EMBED_CEF=OFF -DWEBFRONT_ENABLE_TESTING=ON" "${text} baseline configuration")
endforeach()
foreach(text readme agents)
    _require("${${text}}" "ctest --test-dir build --output-on-failure --parallel 4" "${text} test command")
endforeach()
if(failures)
    list(JOIN failures "\n  " joined)
    message(FATAL_ERROR "Newcomer documentation drifted from the code:\n  ${joined}")
endif()
message(STATUS "Newcomer documentation matches the examples and CI")
