# Keep each CTest assertion/filter name while amortizing the browser startup over compatible commands.
# Project mutations between sessions remain real CTest fixtures. OFF retains one process per case for diagnosis.
option(WEBFRONT_TEST_SESSIONS "Run compatible wf commands in one browser with fresh frames" ON)

function(webfront_record_suite_case group name status command timeout)
    string(REPLACE "|" ";" words "${command}")
    set(arguments "[]")
    set(index 0)
    foreach(word IN LISTS words)
        string(REPLACE "\\" "\\\\" word "${word}")
        string(REPLACE "\"" "\\\"" word "${word}")
        string(JSON arguments SET "${arguments}" ${index} "\"${word}\"")
        math(EXPR index "${index} + 1")
    endforeach()
    set(item "{}")
    string(JSON item SET "${item}" name "\"${name}\"")
    string(JSON item SET "${item}" expect "\"${status}\"")
    string(JSON item SET "${item}" command "${arguments}")
    string(JSON item SET "${item}" timeout "\"${timeout}\"")
    get_property(total GLOBAL PROPERTY "wf-suite-timeout-${group}")
    if(NOT total)
        set(total 0)
    endif()
    math(EXPR total "${total} + ${timeout}")
    set_property(GLOBAL PROPERTY "wf-suite-timeout-${group}" "${total}")
    get_property(cases GLOBAL PROPERTY "wf-suite-${group}")
    if(NOT cases)
        set(cases "[]")
    endif()
    string(JSON length LENGTH "${cases}")
    string(JSON cases SET "${cases}" ${length} "${item}")
    set_property(GLOBAL PROPERTY "wf-suite-${group}" "${cases}")
endfunction()

function(webfront_add_driver_suite group)
    cmake_parse_arguments(ARG "PINNED" "PROJECT;MANIFEST_DIR" "REQUIRES" ${ARGN})
    get_property(cases GLOBAL PROPERTY "wf-suite-${group}")
    if(NOT cases)
        return()
    endif()
    set(suite "${CMAKE_CURRENT_BINARY_DIR}/driver-sessions/${group}.json")
    file(GENERATE OUTPUT "${suite}" CONTENT "${cases}\n")
    get_property(timeout GLOBAL PROPERTY "wf-suite-timeout-${group}")
    math(EXPR ctest_timeout "${timeout} + 20")
    set(options -DPROJECT=${ARG_PROJECT} -DMANIFEST_DIR=${ARG_MANIFEST_DIR}
        -DSUITE=${suite} -DREPORT_DIR=${CMAKE_CURRENT_BINARY_DIR}/driver-sessions/${group}
        -DPROFILE=${CMAKE_CURRENT_BINARY_DIR}/wf-profiles/${group} -DEXPECT_STATUS=0 -DTIMEOUT=${timeout})
    if(ARG_PINNED)
        list(APPEND options -DENVIRONMENT= -DINTEGRITY=)
    endif()
    add_test(NAME ${group} COMMAND ${_wf_run} ${options} -P ${PROJECT_SOURCE_DIR}/test/cmake/RunWfDriver.cmake)
    webfront_set_browser_test_properties(${group} "${CMAKE_CURRENT_SOURCE_DIR}" ${ctest_timeout})
    set(lock "${ARG_PROJECT}")
    if(group STREQUAL "SelfBuildSession")
        set(lock self-build-project)
    endif()
    set_tests_properties(${group} PROPERTIES FIXTURES_REQUIRED "${ARG_REQUIRES}" FIXTURES_SETUP ${group}
        RESOURCE_LOCK "${lock}")
endfunction()
